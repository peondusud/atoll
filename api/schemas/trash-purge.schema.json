{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peondusud/atoll/api/schemas/trash-purge.schema.json",
  "title": "atoll trash purge --json",
  "description": "Each entry it reaches, by path in byte order, then by operation, with why it goes (specs.md §17, §17.4), and the disks whose trash still holds more than trash.max_size of their capacity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied",
    "bytes",
    "entries",
    "full"
  ],
  "properties": {
    "applied": {
      "type": "boolean",
      "description": "Whether it was allowed to write."
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "The sizes of the entries to-purge or purged."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "full": {
      "type": "array",
      "description": "The disks whose trash still holds more than trash.max_size of their capacity once the entries purged, or for a run that may not write those to-purge, are gone, by id in byte order: what is left there waits for its time.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disk",
        "op",
        "size",
        "why",
        "outcome"
      ],
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "path_b64"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "path_b64": {
          "type": "string",
          "minLength": 1
        },
        "disk": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "description": "expired: it reached expires_ns; max-size: it goes for room on a disk whose trash holds more than trash.max_size; older-than: it was trashed at least --older-than ago.",
          "enum": [
            "expired",
            "max-size",
            "older-than"
          ]
        },
        "outcome": {
          "enum": [
            "purged",
            "to-purge",
            "changed",
            "disk-unavailable",
            "io-error"
          ]
        }
      }
    }
  }
}
