# The daemon that runs for good (specs.md §15.13), as a dedicated user with only the capabilities it needs.
# Install: useradd --system --no-create-home --shell /usr/sbin/nologin atoll
#          cp atoll.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now atoll
[Unit]
Description=Atoll: file-level redundancy for a media library
Documentation=https://github.com/peondusud/atoll/blob/main/specs.md
# The disks are mounted first; the network is for the alerts, and for a UPS read through NUT on another machine; upsd
# first when NUT runs here (specs.md §20). An After= on a unit that is not installed asks nothing.
After=local-fs.target remote-fs.target network-online.target nut-server.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/atoll daemon
# systemctl reload atoll: the configuration read again (specs.md §15.13).
ExecReload=/bin/kill -HUP $MAINPID
User=atoll
Group=atoll
# Where smartctl, mount, umount and what mount runs are found: the system's own folders, which root alone writes and
# the packages fill, whatever systemd's default PATH or a DefaultEnvironment= says. /usr/local is left out: what an
# account that may write there put in it would run with the capabilities below (docs/threat-model.md, G19).
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
# No supplementary group: CAP_DAC_READ_SEARCH reads a device's head to confirm a disk (specs.md §10) whatever the
# device's mode, as it reads every file, and the group disk, which writes every block device, gave nothing more.
# fanotify marks, the remount after a USB reset and mergerfs's runtime branches need CAP_SYS_ADMIN; reading
# every file, and making copies with their mode and owner, the others: CAP_FSETID keeps setgid on a copy, or a folder
# made for it, whose group is not atoll's, which the kernel takes off otherwise without a word (measured). smartctl,
# which the daemon runs once an hour, reads SMART through ATA pass-through, which takes CAP_SYS_RAWIO (specs.md §23); so
# does the check every 30 s that asks a disk whether it spins, CHECK POWER MODE, which wakes none (§10).
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_SYS_RAWIO
NoNewPrivileges=yes
# The calls the daemon and what it runs make, measured in qemu on Linux 6.12 and 7.3 (test/loopdev/units_test.go, which
# starts this unit as it is, a call out of the list ending the process): systemd's set for system services; @mount for
# mount(8), umount(8) and mount.ntfs-3g, which the remount runs, and open_tree, which reads whether a mount point is
# immutable (§10); fanotify's two calls, and open_by_handle_at for what a mark reports (§15.1). Any other call fails
# with EPERM, as systemd's own units have it, rather than ending the daemon in the middle of an operation.
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount fanotify_init fanotify_mark open_by_handle_at
SystemCallErrorNumber=EPERM
# The API's socket, sd_notify, and the system bus, through which systemctl has systemd mount a disk again after a USB
# reset (deploy/50-atoll.rules); the alerts, the media servers, NUT and OTLP over IPv4 and IPv6; netlink, through which
# Go reads the machine's addresses.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# A filter of calls, and a namespace of its own for the host's name alone: no mount namespace and no device policy
# (measured, as above).
ProtectClock=yes
ProtectHostname=yes
# What the daemon makes with no mode to copy, its folders of the trash, its catalog and its backups, is closed to other
# accounts. A copy, and each folder made for one, takes its source's mode whatever the mask (specs.md §14.2); a folder
# of the library that no disk holds any more, made for a file moved there, is made 0755 whatever the mask (§17.4).
UMask=0027
# Left out, as each breaks what the daemon does:
# - RestrictSUIDSGID: a copy, a folder made for it and a mode carried to the other copies take setuid and setgid with
#   the rest of the mode (specs.md §14, §15.12), as a shared folder made 2775, the mode openmediavault gives them, has:
#   with it, nothing of such a folder was copied ("make folder: operation not permitted", measured).
# - DevicePolicy, DeviceAllow: the remount opens the disk's block device for writing, under the number it comes back
#   with after a USB reset, and systemd reads the device groups such a list names once, when the unit starts; a list
#   would refuse a disk whose driver loads after that. The capabilities reach every device all the same.
# No PrivateTmp, ProtectHome, ProtectSystem, ProtectKernelTunables, ProtectKernelModules, ProtectKernelLogs,
# ProtectControlGroups, PrivateDevices or other setting that gives the service a mount namespace of its own: in one,
# what the daemon mounts, as a disk again after a USB reset, stays its own, and the host, mergerfs and the media
# servers keep the dead mount, whatever MountFlags says (systemd.exec(5)). A test forbids them, and one in qemu checks
# that the daemon runs in the host's mount namespace.
# The catalog in /var/lib/atoll, the configuration in /etc/atoll, the local API's socket in /run/atoll.
StateDirectory=atoll
# The catalog lists every path of the library, its trash and its history: its folder is closed to other accounts, as
# the socket is. Root's commands reach it all the same.
StateDirectoryMode=0750
ConfigurationDirectory=atoll
RuntimeDirectory=atoll
# A pass under way stops at its next step; what an operation left is the reprise's at the next start.
TimeoutStopSec=2min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
