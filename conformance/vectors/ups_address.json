{
  "format_version": 1,
  "spec": "specs.md \u00a720",
  "description": "Where the daemon reads the UPS, from ups.nut, as NUT writes it: <ups>@<host>[:<port>]. The name is what comes before the first @, and must not be empty; the host, what comes after it, must not be empty nor hold another @. A host in brackets is an IPv6 address, which a port may follow after a colon; one that holds more than one colon without brackets is an IPv6 address with no port; otherwise a colon starts the port. A port is ASCII digits with no leading zero, 1 to 65535, as in api.listen; 3493, NUT's, when there is none.",
  "cases": [
    {"note": "a name and a host: NUT's port", "nut": "ups@localhost", "ups": "ups", "host": "localhost", "port": 3493},
    {"note": "an IPv4 address", "nut": "myups@192.168.1.10", "ups": "myups", "host": "192.168.1.10", "port": 3493},
    {"note": "a host and a port", "nut": "ups@nas.lan:3494", "ups": "ups", "host": "nas.lan", "port": 3494},
    {"note": "the lowest port", "nut": "ups@host:1", "ups": "ups", "host": "host", "port": 1},
    {"note": "the highest port", "nut": "ups@host:65535", "ups": "ups", "host": "host", "port": 65535},
    {"note": "an IPv6 address in brackets", "nut": "ups@[::1]", "ups": "ups", "host": "::1", "port": 3493},
    {"note": "an IPv6 address in brackets, and a port", "nut": "ups@[::1]:3494", "ups": "ups", "host": "::1", "port": 3494},
    {"note": "more than one colon and no brackets: an IPv6 address, with no port", "nut": "ups@::1", "ups": "ups", "host": "::1", "port": 3493},
    {"note": "an IPv6 address with its zone", "nut": "ups@fe80::1%eth0", "ups": "ups", "host": "fe80::1%eth0", "port": 3493},
    {"note": "an IPv6 address with its zone, in brackets, and a port", "nut": "ups@[fe80::1%eth0]:3494", "ups": "ups", "host": "fe80::1%eth0", "port": 3494},
    {"note": "not set", "nut": "", "error": true},
    {"note": "no host", "nut": "ups", "error": true},
    {"note": "no name", "nut": "@host", "error": true},
    {"note": "an empty host", "nut": "ups@", "error": true},
    {"note": "an empty port", "nut": "ups@host:", "error": true},
    {"note": "port 0", "nut": "ups@host:0", "error": true},
    {"note": "past the highest port", "nut": "ups@host:65536", "error": true},
    {"note": "a port no integer holds", "nut": "ups@host:99999999999999999999", "error": true},
    {"note": "a sign", "nut": "ups@host:+1", "error": true},
    {"note": "a leading zero, as api.listen refuses it", "nut": "ups@host:03494", "error": true},
    {"note": "a port with a letter", "nut": "ups@host:3a", "error": true},
    {"note": "a bracket not closed", "nut": "ups@[::1", "error": true},
    {"note": "something after the bracket that is no port", "nut": "ups@[::1]x", "error": true},
    {"note": "empty brackets", "nut": "ups@[]", "error": true},
    {"note": "empty brackets and a port", "nut": "ups@[]:3493", "error": true},
    {"note": "a second @", "nut": "a@b@c", "error": true},
    {"note": "a port and no host", "nut": "ups@:3493", "error": true}
  ]
}
