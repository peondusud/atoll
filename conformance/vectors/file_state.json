{
  "format_version": 1,
  "spec": "specs.md §4",
  "description": "The one state a file shows when several apply: the first in the order corrupt, conflict, unavailable, name-incompatible, name-collision, degraded, pending, unprotected, ok. With none, it is ok.",
  "cases": [
    { "applies": [], "state": "ok", "note": "nothing applies" },
    { "applies": ["ok"], "state": "ok" },
    { "applies": ["unprotected"], "state": "unprotected" },
    { "applies": ["pending"], "state": "pending" },
    { "applies": ["degraded"], "state": "degraded" },
    { "applies": ["name-collision"], "state": "name-collision" },
    { "applies": ["name-incompatible"], "state": "name-incompatible" },
    { "applies": ["conflict"], "state": "conflict" },
    { "applies": ["corrupt"], "state": "corrupt" },
    { "applies": ["unavailable"], "state": "unavailable" },
    { "applies": ["ok", "unprotected"], "state": "unprotected" },
    { "applies": ["unprotected", "pending"], "state": "pending" },
    { "applies": ["pending", "degraded"], "state": "degraded" },
    { "applies": ["degraded", "name-collision"], "state": "name-collision", "note": "a name state needs the user; degraded often heals alone" },
    { "applies": ["name-collision", "degraded"], "state": "name-collision", "note": "the order of the input does not matter" },
    { "applies": ["name-collision", "name-incompatible"], "state": "name-incompatible" },
    { "applies": ["degraded", "name-incompatible"], "state": "name-incompatible" },
    { "applies": ["name-incompatible", "conflict"], "state": "conflict" },
    { "applies": ["conflict", "corrupt"], "state": "corrupt" },
    { "applies": ["corrupt", "unavailable"], "state": "corrupt", "note": "only the state remembers it, and an outage must not make the catalog forget" },
    { "applies": ["unavailable", "conflict"], "state": "conflict", "note": "likewise" },
    { "applies": ["unavailable", "name-incompatible"], "state": "unavailable" },
    { "applies": ["degraded", "degraded"], "state": "degraded", "note": "a state given twice" },
    { "applies": ["ok", "unprotected", "pending", "degraded", "name-collision", "name-incompatible", "conflict", "corrupt", "unavailable"], "state": "corrupt", "note": "all of them" },
    { "applies": ["fine"], "error": true, "note": "not a state" },
    { "applies": ["OK"], "error": true, "note": "states are lowercase" },
    { "applies": ["degraded", "fine"], "error": true, "note": "one unknown state is enough" },
    { "applies": ["fine", "corrupt"], "error": true, "note": "even after the first in the order" },
    { "applies": ["corrupt", "fine"], "error": true, "note": "or before it" }
  ]
}
