    {"fs": "ntfs", "entry": {"fstype": "ntfs", "super_options": ["rw", "umask=00", "iocharset=utf8", "case_sensitive", "errors=continue", "mft_zone_multiplier=1", "native_symlink=raw", "symlink=wsl"]}, "no_magic": true, "state": "missing", "reason": "wrong-filesystem"},
