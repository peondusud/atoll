    {"fs": "ntfs", "entry": {"fstype": "autofs"}, "state": "missing", "reason": "wrong-filesystem"},
    {"device": "gone", "state": "missing", "reason": "device-gone", "note": "measured: the node of an unplugged USB disk"},
    {"device": "unreadable", "state": "missing", "reason": "device-unreadable", "note": "no privilege, or an I/O error"},
    {"entry": {"super_options": ["rw", "shutdown"]}, "state": "missing", "reason": "io-error", "note": "the filesystem shut down, on a device that still answers"},
