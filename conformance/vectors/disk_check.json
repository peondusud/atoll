{
  "format_version": 1,
  "spec": "specs.md §10",
  "description": "What a mount check concludes from the answers of a machine: the first question that fails gives the state and the reason, and what is left out is a healthy answer. The cases marked measured come from docs/research/disk-identity.md.",
  "cases": [
    {"state": "online", "note": "a healthy ext4"},
    {"fs": "xfs", "state": "online", "note": "a healthy XFS"},
    {"fs": "btrfs", "state": "online", "note": "a healthy btrfs"},
    {"fs": "ntfs", "state": "online", "note": "a healthy ntfs3"},
    {"fs": "ntfs", "entry": {"fstype": "fuseblk", "super_options": ["rw", "user_id=0", "group_id=0", "allow_other", "blksize=4096"]}, "state": "online", "note": "ntfs-3g and lowntfs-3g show no iocharset, and need none"},
    {"fs": "ntfs", "entry": {"super_options": ["rw", "uid=0", "gid=0", "acl", "iocharset=utf8", "prealloc"]}, "state": "online", "note": "ntfs3 on Linux 7.3 with ads=0, which then shows no ads"},
    {"entry": {"mount_options": ["rw", "relatime", "nofail"]}, "state": "online", "note": "other options change nothing"},
    {"path": "absent", "state": "missing", "reason": "not-mounted"},
    {"path": "io-error", "state": "missing", "reason": "io-error", "note": "never read as an absent disk (invariant 4)"},
    {"entry": {"mount_point": "/"}, "state": "missing", "reason": "not-mounted", "note": "measured: an empty mount point gives its parent's entry"},
    {"no_entry": true, "state": "missing", "reason": "not-mounted", "note": "the table has no entry for that id: it changed between two reads"},
    {"entry": {"mount_point": "/srv/t1"}, "state": "missing", "reason": "not-mounted", "note": "a path through a symlinked folder"},
    {"entry": {"mount_point": "/mnt/T1"}, "state": "missing", "reason": "not-mounted", "note": "compared exactly"},
    {"entry": {"mount_point": "/mnt/t1/"}, "state": "missing", "reason": "not-mounted", "note": "compared exactly"},
    {"mount": "/mnt/t1", "entry": {"mount_point": "/mnt"}, "state": "missing", "reason": "not-mounted", "note": "its parent is not it"},
    {"entry": {"root": "/sub"}, "state": "missing", "reason": "partial-mount", "note": "a bind mount of a folder"},
    {"fs": "btrfs", "entry": {"root": "/sv"}, "state": "missing", "reason": "partial-mount", "note": "a btrfs subvolume"},
    {"entry": {"root": "/media"}, "state": "missing", "reason": "partial-mount", "note": "even the managed root itself"},
    {"entry": {"root": "//"}, "state": "missing", "reason": "partial-mount", "note": "compared exactly"},
    {"entry": {"fstype": "xfs"}, "state": "missing", "reason": "wrong-filesystem"},
    {"entry": {"fstype": "ext3"}, "state": "missing", "reason": "wrong-filesystem", "note": "ext3 shares its magic with ext4, and the type tells them apart"},
    {"entry": {"fstype": "ext2"}, "state": "missing", "reason": "wrong-filesystem"},
    {"entry": {"fstype": "tmpfs"}, "state": "missing", "reason": "wrong-filesystem", "note": "a tmpfs mounted over the disk"},
    {"entry": {"fstype": "fuseblk"}, "state": "missing", "reason": "wrong-filesystem", "note": "fuseblk only for NTFS"},
    {"entry": {"fstype": "ntfs3"}, "state": "missing", "reason": "wrong-filesystem"},
    {"entry": {"fstype": "EXT4"}, "state": "missing", "reason": "wrong-filesystem", "note": "compared exactly"},
    {"fs": "xfs", "entry": {"fstype": "ext4"}, "state": "missing", "reason": "wrong-filesystem"},
