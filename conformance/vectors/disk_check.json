    {"fs": "ntfs", "entry": {"super_options": ["rw", "uid=0", "gid=0", "acl", "iocharset=utf8", "prealloc", "ads"]}, "state": "readonly", "reason": "ads", "note": "measured: the default of ntfs3 on Linux 7.3"},
