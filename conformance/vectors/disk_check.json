    {"id": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d", "entry": {"super_options": ["rw", "shutdown"]}, "state": "missing", "reason": "wrong-identifier", "note": "question 8 before 9"},
