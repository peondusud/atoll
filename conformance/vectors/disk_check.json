    {"fs": "ntfs", "entry": {"super_options": ["rw", "iocharset=iso8859-1"]}, "state": "readonly", "reason": "iocharset"},
    {"fs": "ntfs", "entry": {"super_options": ["rw", "iocharset=UTF8"]}, "state": "readonly", "reason": "iocharset", "note": "compared whole"},
