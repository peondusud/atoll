    {"fs": "ntfs", "id": "01D9F3A2B4C5E6F8", "state": "missing", "reason": "wrong-identifier", "note": "one digit of the serial"},
    {"fs": "ntfs", "id": "01d9f3a2b4c5e6f7", "state": "missing", "reason": "wrong-identifier", "note": "compared exactly"},
