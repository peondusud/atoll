    {"other_case": true, "state": "readonly", "reason": "ignore-case", "note": "asked on every driver"},
    {"variant": "casefold", "state": "readonly", "reason": "casefold"},
    {"fs": "xfs", "variant": "ascii-ci", "state": "readonly", "reason": "ascii-ci"},
    {"no_journal": true, "state": "readonly", "reason": "no-journal", "note": "measured: mkfs.ext4 -O ^has_journal"},
    {"entry": {"mount_options": ["ro", "relatime"], "super_options": ["ro"]}, "state": "readonly", "reason": "read-only-mount", "note": "measured: mount -o ro"},
    {"entry": {"mount_options": ["ro", "relatime"]}, "state": "readonly", "reason": "read-only-mount", "note": "measured: a read-only bind of a filesystem that is not"},
