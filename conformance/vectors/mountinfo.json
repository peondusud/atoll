    {"text": "9223372036854775807 18446744073709551615 4294967295:4294967295 / /a rw - ext4 /d rw\n", "entries": [{"id": 9223372036854775807, "major": 4294967295, "minor": 4294967295, "root": "/", "mount_point": "/a", "mount_options": ["rw"], "fstype": "ext4", "source": "/d", "super_options": ["rw"]}], "note": "the largest numbers: a parent of 64 bits, and the largest id a vector can write"},
