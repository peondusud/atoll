  "spec": "specs.md §10",
  "description": "The text of /proc/self/mountinfo, into its entries. A line that cannot be read is counted, and says nothing about the others. Worked out from proc(5) and from lines measured on Linux 6.12 and 7.3.1.",
  "cases": [
    {"text": "36 35 98:0 /mnt1 /mnt2 rw,noatime master:1 - ext3 /dev/root rw,errors=continue\n", "entries": [{"id": 36, "major": 98, "minor": 0, "root": "/mnt1", "mount_point": "/mnt2", "mount_options": ["rw", "noatime"], "fstype": "ext3", "source": "/dev/root", "super_options": ["rw", "errors=continue"]}], "note": "the example of proc(5)"},
    {"text": "33 2 7:0 / /m/a rw,relatime - ext4 /dev/loop0 rw\n", "entries": [{"id": 33, "major": 7, "minor": 0, "root": "/", "mount_point": "/m/a", "mount_options": ["rw", "relatime"], "fstype": "ext4", "source": "/dev/loop0", "super_options": ["rw"]}], "note": "measured: no optional field"},
    {"text": "33 2 7:0 / /m/a rw,relatime shared:1 master:2 propagate_from:3 - ext4 /dev/loop0 rw\n", "entries": [{"id": 33, "major": 7, "minor": 0, "root": "/", "mount_point": "/m/a", "mount_options": ["rw", "relatime"], "fstype": "ext4", "source": "/dev/loop0", "super_options": ["rw"]}], "note": "several optional fields"},
