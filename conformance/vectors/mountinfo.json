    {"text": "33 2 7:0 / /m/a rw,relatime - ext4 /dev/loop0 rw\n34 33 0:29 / /m/a rw,relatime - tmpfs tmpfs rw,inode64\n", "entries": [{"id": 33, "major": 7, "minor": 0, "root": "/", "mount_point": "/m/a", "mount_options": ["rw", "relatime"], "fstype": "ext4", "source": "/dev/loop0", "super_options": ["rw"]}, {"id": 34, "major": 0, "minor": 29, "root": "/", "mount_point": "/m/a", "mount_options": ["rw", "relatime"], "fstype": "tmpfs", "source": "tmpfs", "super_options": ["rw", "inode64"]}], "note": "measured: mounts stacked on one path, in order"},
