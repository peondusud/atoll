    {"text": "1 0 8:1 /a\\134b /c\\012d\\043e rw - ext4 /dev/my\\040disk rw\n", "entries": [{"id": 1, "major": 8, "minor": 1, "root": "/a\\b", "mount_point": "/c\nd#e", "mount_options": ["rw"], "fstype": "ext4", "source": "/dev/my disk", "super_options": ["rw"]}], "note": "a backslash, a newline and a #, in the root, the mount point and the source"},
