{
  "format_version": 1,
  "spec": "specs.md §15.4",
  "description": "What a pass decides about a file one of whose copies is edited or replaced: what to read first, then whether the change is to its content, to its metadata only, or a conflict. A hash is any string here, compared for equality only.",
  "cases": [
    {"note": "nothing changed", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "none"}},
    {"note": "a file in conflict changes nothing", "file": {"state": "conflict", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "none"}},
    {"note": "nor does a corrupt one", "file": {"state": "corrupt", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "none"}},
    {"note": "a copy gone is decided first", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "replaced", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "gone", "state": "ok", "size": 10}], "decision": {"kind": "wait"}},
    {"note": "so is a copy moved", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "moved", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "wait"}},
    {"note": "and uncertain or own", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "uncertain", "state": "ok", "size": 10}, {"disk": "t3", "position": 2, "verdict": "own", "state": "ok", "size": 10}], "decision": {"kind": "wait"}},
    {"note": "a copy replaced by what is no regular file, or by a file another copy moved to", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "replaced", "other": true, "state": "ok", "size": 10, "due": true, "readable": true}], "decision": {"kind": "wait"}},
    {"note": "only such a copy: no changed copy, nothing to decide", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "replaced", "other": true, "state": "ok", "size": 10, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "none"}},
    {"note": "a job running", "file": {"state": "ok", "size": 10, "hash": "old", "running": true}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "wait"}},
    {"note": "not due", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "wait"}},
    {"note": "one of two changed copies not due", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "readable": true}], "decision": {"kind": "wait"}},
    {"note": "a stale copy changed: a version that came before", "file": {"state": "ok", "size": 10, "hash": "new"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "stale", "size": 8, "due": true, "readable": true}], "decision": {"kind": "conflict", "changed": ["t2"]}},
    {"note": "two sizes among the changed copies", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "replaced", "state": "ok", "size": 10, "due": true, "readable": true}], "decision": {"kind": "conflict", "changed": ["t1", "t2"]}},
    {"note": "one changed copy of another size: modified, with nothing read", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t3", "position": 2, "verdict": "unknown", "state": "unavailable", "size": 10}], "decision": {"kind": "modified", "changed": ["t2"], "stale": ["t1", "t3"]}},
    {"note": "the same with no hash", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "replaced", "state": "ok", "size": 3, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "surplus", "size": 10, "readable": true}], "decision": {"kind": "modified", "changed": ["t1"], "stale": ["t2"]}},
    {"note": "a copy already stale stays so", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "stale", "size": 7, "readable": true}], "decision": {"kind": "modified", "changed": ["t1"], "stale": ["t2"]}},
    {"note": "every copy changed, to one other size", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}], "decision": {"kind": "read", "read": ["t1", "t2"]}},
    {"note": "read: one content", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "new"}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "new"}], "decision": {"kind": "modified", "changed": ["t1", "t2"], "hash": "new"}},
    {"note": "read: two contents", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "new"}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "new2"}], "decision": {"kind": "conflict", "changed": ["t1", "t2"]}},
    {"note": "half read", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "new"}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}], "decision": {"kind": "read", "read": ["t2"]}},
    {"note": "the file's size, with a hash: only the changed copy is read", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true}], "decision": {"kind": "read", "read": ["t2"]}},
    {"note": "the same content: metadata only", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "old"}], "decision": {"kind": "metadata", "changed": ["t2"], "hash": "old"}},
    {"note": "another content: modified", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "new"}], "decision": {"kind": "modified", "changed": ["t2"], "stale": ["t1"], "hash": "new"}},
    {"note": "two changed copies of the file's size, one content", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "new"}, {"disk": "t2", "position": 1, "verdict": "replaced", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "new"}, {"disk": "t3", "position": 2, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "modified", "changed": ["t1", "t2"], "stale": ["t3"], "hash": "new"}},
    {"note": "two changed copies of the file's size, two contents, one of them the file's", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "old"}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "new"}], "decision": {"kind": "conflict", "changed": ["t1", "t2"]}},
    {"note": "no hash: the first copy there, ok or surplus, on a disk that can be read, is the reference, and both are read by position", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "unknown", "state": "ok", "size": 10}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10}, {"disk": "t3", "position": 2, "verdict": "there", "state": "stale", "size": 10, "readable": true}, {"disk": "t4", "position": 3, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true}, {"disk": "t5", "position": 4, "verdict": "there", "state": "surplus", "size": 10, "readable": true}], "decision": {"kind": "read", "read": ["t4", "t5"]}},
    {"note": "no hash, read: the reference's content is metadata only, and the file takes that hash", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "same"}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true, "hash": "same"}], "decision": {"kind": "metadata", "changed": ["t1"], "reference": "t2", "hash": "same"}},
    {"note": "no hash, read: another content is modified, and the reference goes stale", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "new"}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true, "hash": "old"}], "decision": {"kind": "modified", "changed": ["t1"], "stale": ["t2"], "hash": "new"}},
    {"note": "no hash and nothing to compare with, while another copy did not change: it waits, and nothing is read", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "ok", "size": 10}, {"disk": "t3", "position": 2, "verdict": "unknown", "state": "ok", "size": 10}], "decision": {"kind": "wait"}},
    {"note": "no hash, and every copy changed: each is read", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true}], "decision": {"kind": "read", "read": ["t1"]}},
    {"note": "no hash, every copy changed, read: modified, with nothing stale", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true, "hash": "h"}], "decision": {"kind": "modified", "changed": ["t1"], "hash": "h"}},
    {"note": "several changed copies of another size, with no hash: only they are read, as another size needs no reference, and a copy that cannot be read makes nothing wait", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true}, {"disk": "t3", "position": 2, "verdict": "there", "state": "ok", "size": 10}], "decision": {"kind": "read", "read": ["t1", "t2"]}},
    {"note": "another size is a modification, whatever its hash says", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "old"}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 12, "due": true, "readable": true, "hash": "old"}, {"disk": "t3", "position": 2, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "modified", "changed": ["t1", "t2"], "stale": ["t3"], "hash": "old"}},
    {"note": "the reference is there: a copy this look did not reach is none, even on a disk that can be read", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "unknown", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true}, {"disk": "t3", "position": 2, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "read", "read": ["t2", "t3"]}},
    {"note": "the reference is ok or surplus: not unavailable, nor corrupt", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "unavailable", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "there", "state": "corrupt", "size": 10, "readable": true}, {"disk": "t3", "position": 2, "verdict": "edited", "state": "ok", "size": 10, "due": true, "readable": true}, {"disk": "t4", "position": 3, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "read", "read": ["t3", "t4"]}},
    {"note": "a changed copy is not on a disk that can be read: it waits", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 10, "due": true}], "decision": {"kind": "wait"}},
    {"note": "nor need it be, when nothing is read", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "t2", "position": 1, "verdict": "edited", "state": "ok", "size": 4, "due": true}], "decision": {"kind": "modified", "changed": ["t2"], "stale": ["t1"]}},
    {"note": "copies given in any order come out by position", "file": {"state": "ok", "size": 10, "hash": "old"}, "copies": [{"disk": "b", "position": 2, "verdict": "there", "state": "ok", "size": 10, "readable": true}, {"disk": "c", "position": 0, "verdict": "edited", "state": "ok", "size": 1, "due": true, "readable": true}, {"disk": "a", "position": 1, "verdict": "there", "state": "ok", "size": 10, "readable": true}], "decision": {"kind": "modified", "changed": ["c"], "stale": ["a", "b"]}},
    {"note": "an unknown verdict", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "changed", "state": "ok", "size": 10}], "error": true},
    {"note": "an unknown copy state", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "fine", "size": 10}], "error": true},
    {"note": "a pending copy has nothing on its disk to judge", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "pending", "size": 10}], "error": true},
    {"note": "an unknown file state", "file": {"state": "odd", "size": 10}, "copies": [], "error": true},
    {"note": "a disk twice", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10}, {"disk": "t1", "position": 1, "verdict": "there", "state": "ok", "size": 10}], "error": true},
    {"note": "a position twice", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "there", "state": "ok", "size": 10}, {"disk": "t2", "position": 0, "verdict": "there", "state": "ok", "size": 10}], "error": true},
    {"note": "other on a copy not replaced", "file": {"state": "ok", "size": 10}, "copies": [{"disk": "t1", "position": 0, "verdict": "edited", "other": true, "state": "ok", "size": 10}], "error": true}
  ]
}
