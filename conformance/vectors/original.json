{
  "format_version": 1,
  "spec": "specs.md §7",
  "description": "The original of a file: the eligible copy with the oldest creation time, or first_seen where it is absent, in exact nanoseconds; ties go to the earliest first_seen, then the lowest position. previous is given for a file in conflict only, and stays the original while its copy is eligible. An empty original means no copy is eligible.",
  "cases": [
    { "copies": [], "original": "", "note": "no copies" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 500 }], "original": "t1", "note": "one copy" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 500 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 500 }], "original": "t2", "note": "the oldest wins, whatever the position" },
    { "copies": [{ "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 500 }, { "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 500 }], "original": "t2", "note": "the order of the input does not matter" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "first_seen_ns": 100 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t1", "note": "first_seen stands in where the creation time is absent, and is older here" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "first_seen_ns": 300 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 400 }], "original": "t2", "note": "and is younger here" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "first_seen_ns": 100 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "first_seen_ns": 90 }], "original": "t2", "note": "no creation time on either" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 60 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "original": "t2", "note": "a tie: the earliest first_seen" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "first_seen_ns": 100 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "original": "t2", "note": "a tie between a first_seen and a creation time" },
    { "copies": [{ "disk": "a", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "b", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "original": "b", "note": "still a tie: the lowest position, not the disk's name" },
    { "copies": [{ "disk": "e", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 1000000123, "first_seen_ns": 1 }, { "disk": "n", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 1000000100, "first_seen_ns": 2 }], "original": "n", "note": "exact nanoseconds: at 100 ns these would tie, and e would win" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 5, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": -5, "first_seen_ns": 50 }], "original": "t2", "note": "before the epoch" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 9223372036854775807, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": -9223372036854775808, "first_seen_ns": 50 }], "original": "t2", "note": "the limits: a comparison by subtraction would wrap" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "stale", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "stale: never, even when older" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "corrupt", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "corrupt: never" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "unavailable", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "unavailable: never" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "pending", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "pending: never" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "surplus", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t1", "note": "surplus: in sync, so eligible" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "standby", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t1", "note": "standby: the original does not change when a disk sleeps" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "readonly", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t1", "note": "readonly: it can be read" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "draining", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t1", "note": "draining: until it leaves" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "missing", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "missing: never" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "failed", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "failed: never" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "retired", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "original": "t2", "note": "retired: never" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "stale", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "missing", "creation_ns": 200, "first_seen_ns": 50 }], "original": "", "note": "no copy is eligible" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "previous": "t2", "original": "t2", "note": "a conflict: the previous original stays, though t1 is older" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "surplus", "disk_state": "standby", "creation_ns": 200, "first_seen_ns": 50 }], "previous": "t2", "original": "t2", "note": "eligible means the same thing here" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "ok", "disk_state": "missing", "creation_ns": 200, "first_seen_ns": 50 }, { "disk": "t3", "position": 2, "state": "ok", "disk_state": "online", "creation_ns": 150, "first_seen_ns": 50 }], "previous": "t2", "original": "t1", "note": "its disk is missing: the normal rule" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "corrupt", "disk_state": "online", "creation_ns": 90, "first_seen_ns": 50 }], "previous": "t2", "original": "t1", "note": "its copy is corrupt: the normal rule" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "previous": "gone", "original": "t1", "note": "it has no copy any more: the normal rule" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "bad", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "error": true, "note": "an unknown copy state" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "bad", "creation_ns": 100, "first_seen_ns": 50 }], "error": true, "note": "an unknown disk state" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 1, "state": "bad", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "error": true, "note": "even on a copy that would not win" },
    { "copies": [{ "disk": "", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "error": true, "note": "no disk" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t1", "position": 1, "state": "ok", "disk_state": "online", "creation_ns": 200, "first_seen_ns": 50 }], "error": true, "note": "two copies on one disk (R-06)" },
    { "copies": [{ "disk": "t1", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }, { "disk": "t2", "position": 0, "state": "ok", "disk_state": "online", "creation_ns": 100, "first_seen_ns": 50 }], "error": true, "note": "two disks at one position: the tie would have no answer" }
  ]
}
