{
  "format_version": 1,
  "spec": "specs.md §15.1",
  "description": "The watcher's events grouped per disk and logical path. A group gathers what its events said and who made them, each set in byte order, and the times of its first and last event. It is ripe once now - last >= debounce, and ripe groups come out by disk identifier, then by path, in byte order. A group still waiting counts in waiting, and next_due_ns is the earliest time one of them will be ripe; it is left out when none waits.",
  "cases": [
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "Films/a.mkv", "kind": "created", "origin": "user", "at_ns": 1000}], "now_ns": 30000001000, "ripe": [{"disk": "t1", "path": "Films/a.mkv", "kinds": ["created"], "origins": ["user"], "first_ns": 1000, "last_ns": 1000}], "waiting": 0, "note": "ripe exactly at last + debounce"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "Films/a.mkv", "kind": "created", "origin": "user", "at_ns": 1000}], "now_ns": 30000000999, "ripe": [], "waiting": 1, "next_due_ns": 30000001000, "note": "1 ns early: it waits"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "created", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "a", "kind": "written", "origin": "user", "at_ns": 5000000000}, {"disk": "t1", "path": "a", "kind": "attrib", "origin": "view", "at_ns": 6000000000}], "now_ns": 36000000000, "ripe": [{"disk": "t1", "path": "a", "kinds": ["attrib", "created", "written"], "origins": ["user", "view"], "first_ns": 0, "last_ns": 6000000000}], "waiting": 0, "note": "events of one path merge; each set in byte order"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "written", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "a", "kind": "written", "origin": "user", "at_ns": 20000000000}], "now_ns": 40000000000, "ripe": [], "waiting": 1, "next_due_ns": 50000000000, "note": "a later event pushes the group back: a file still written is not ripe"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "written", "origin": "user", "at_ns": 20000000000}, {"disk": "t1", "path": "a", "kind": "created", "origin": "user", "at_ns": 0}], "now_ns": 49999999999, "ripe": [], "waiting": 1, "next_due_ns": 50000000000, "note": "events out of order: first and last are the earliest and the latest"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "old", "kind": "written", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "new", "kind": "written", "origin": "user", "at_ns": 25000000000}], "now_ns": 30000000000, "ripe": [{"disk": "t1", "path": "old", "kinds": ["written"], "origins": ["user"], "first_ns": 0, "last_ns": 0}], "waiting": 1, "next_due_ns": 55000000000, "note": "each path ripens on its own"},
    {"debounce_ns": 0, "events": [{"disk": "t2", "path": "b", "kind": "created", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "b", "kind": "created", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "a", "kind": "created", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "B", "kind": "created", "origin": "user", "at_ns": 0}], "now_ns": 0, "ripe": [{"disk": "t1", "path": "B", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}, {"disk": "t1", "path": "a", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}, {"disk": "t1", "path": "b", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}, {"disk": "t2", "path": "b", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}], "waiting": 0, "note": "by disk, then by path, in byte order: B before a; one path on two disks is two groups; a debounce of 0 ripens at once"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "Show", "kind": "moved-from", "folder": true, "origin": "view", "at_ns": 0}, {"disk": "t1", "path": "Show (2020)", "kind": "moved-to", "folder": true, "origin": "view", "at_ns": 0}], "now_ns": 30000000000, "ripe": [{"disk": "t1", "path": "Show", "folder": true, "kinds": ["moved-from"], "origins": ["view"], "first_ns": 0, "last_ns": 0}, {"disk": "t1", "path": "Show (2020)", "folder": true, "kinds": ["moved-to"], "origins": ["view"], "first_ns": 0, "last_ns": 0}], "waiting": 0, "note": "a folder renamed through mergerfs: one group at each end"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "x", "kind": "deleted", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "x", "kind": "created", "folder": true, "origin": "user", "at_ns": 1}], "now_ns": 30000000001, "ripe": [{"disk": "t1", "path": "x", "folder": true, "kinds": ["created", "deleted"], "origins": ["user"], "first_ns": 0, "last_ns": 1}], "waiting": 0, "note": "a file replaced by a folder: the group names a folder once one of its events does"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "x", "kind": "created", "folder": true, "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "x", "kind": "attrib", "origin": "user", "at_ns": 1}], "now_ns": 30000000001, "ripe": [{"disk": "t1", "path": "x", "folder": true, "kinds": ["attrib", "created"], "origins": ["user"], "first_ns": 0, "last_ns": 1}], "waiting": 0, "note": "a later event that does not name a folder leaves the group a folder's"},
    {"debounce_ns": 0, "events": [{"disk": "t1", "path": "b", "kind": "created", "origin": "user", "at_ns": 0}, {"disk": "t2", "path": "a", "kind": "created", "origin": "user", "at_ns": 0}], "now_ns": 0, "ripe": [{"disk": "t1", "path": "b", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}, {"disk": "t2", "path": "a", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}], "waiting": 0, "note": "the disk comes first, then the path"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "late", "kind": "written", "origin": "user", "at_ns": 20000000000}, {"disk": "t1", "path": "early", "kind": "written", "origin": "user", "at_ns": 10000000000}, {"disk": "t2", "path": "later", "kind": "written", "origin": "user", "at_ns": 25000000000}], "now_ns": 30000000000, "ripe": [], "waiting": 3, "next_due_ns": 40000000000, "note": "several wait: the earliest of their times"},
    {"debounce_ns": 30000000000, "events": [{"disk": "u1", "path": "", "kind": "overflow", "origin": "unknown", "at_ns": 0}, {"disk": "u1", "path": "a", "kind": "written", "origin": "unknown", "at_ns": 0}], "now_ns": 30000000000, "ripe": [{"disk": "u1", "path": "", "kinds": ["overflow"], "origins": ["unknown"], "first_ns": 0, "last_ns": 0}, {"disk": "u1", "path": "a", "kinds": ["written"], "origins": ["unknown"], "first_ns": 0, "last_ns": 0}], "waiting": 0, "note": "an overflow is a group at the root, ripe as any other: a rescan of its disk"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "written", "origin": "atoll", "at_ns": 0}, {"disk": "t1", "path": "a", "kind": "written", "origin": "unknown", "at_ns": 0}, {"disk": "t1", "path": "a", "kind": "written", "origin": "view", "at_ns": 0}, {"disk": "t1", "path": "a", "kind": "written", "origin": "user", "at_ns": 0}], "now_ns": 30000000000, "ripe": [{"disk": "t1", "path": "a", "kinds": ["written"], "origins": ["atoll", "unknown", "user", "view"], "first_ns": 0, "last_ns": 0}], "waiting": 0, "note": "every origin, in byte order"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path_b64": "Zm9vL7ouZXA=", "kind": "created", "origin": "user", "at_ns": 0}, {"disk": "t1", "path": "foo/e.ep", "kind": "created", "origin": "user", "at_ns": 0}], "now_ns": 30000000000, "ripe": [{"disk": "t1", "path": "foo/e.ep", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}, {"disk": "t1", "path_b64": "Zm9vL7ouZXA=", "kinds": ["created"], "origins": ["user"], "first_ns": 0, "last_ns": 0}], "waiting": 0, "note": "a name that is not UTF-8 is its own path, compared by its bytes: 0xBA after e"},
    {"debounce_ns": 30000000000, "events": [], "now_ns": 0, "ripe": [], "waiting": 0, "note": "nothing to group"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "renamed", "origin": "user", "at_ns": 0}], "error": true, "note": "a kind outside the list: a rename is moved-from and moved-to"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "created", "origin": "mergerfs", "at_ns": 0}], "error": true, "note": "an origin outside the list"},
    {"debounce_ns": 30000000000, "events": [{"disk": "t1", "path": "a", "kind": "overflow", "origin": "unknown", "at_ns": 0}], "error": true, "note": "an overflow is at the root"},
    {"debounce_ns": -1, "events": [], "error": true, "note": "a negative debounce"}
  ]
}
