    { "seconds": 0, "nanoseconds": 0, "absent": true, "note": "exactly 0: ext4 reports a crtime of 0 like this" },
    { "seconds": 0, "nanoseconds": 1, "ns": 1, "note": "not exactly 0" },
    { "seconds": 1, "nanoseconds": 0, "ns": 1000000000 },
    { "seconds": -1, "nanoseconds": 0, "ns": -1000000000, "note": "before the epoch" },
    { "seconds": -1, "nanoseconds": 999999999, "ns": -1, "note": "the nanoseconds still count forward" },
    { "seconds": -315673600, "nanoseconds": 0, "ns": -315673600000000000, "note": "a FILETIME of 1959, in range" },
    { "seconds": -8520336000, "nanoseconds": 0, "ns": -8520336000000000000, "note": "a FILETIME of 1700, in range" },
    { "seconds": -11644473600, "nanoseconds": 0, "absent": true, "note": "a FILETIME of 0: ntfs3 reports 1601" },
    { "seconds": -9279273600, "nanoseconds": 0, "absent": true, "note": "a FILETIME of 1675, out of range" },
    { "seconds": 10413835200, "nanoseconds": 0, "absent": true, "note": "a FILETIME of 2300, out of range" },
