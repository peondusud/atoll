    {"disks": [{"id": "t1", "position": 0, "state": "online"}, {"id": "t2", "position": 1, "state": "online"}], "entries": [{"disk": "t2", "kind": "dir", "mode": 448, "uid": 1000, "gid": 100, "size": 4096, "mtime_ns": 9}, {"disk": "t1", "kind": "dir", "mode": 488, "uid": 5, "gid": 6, "size": 12, "mtime_ns": 7}], "node": {"kind": "dir", "disk": "t1", "mode": 488, "uid": 5, "gid": 6, "size": 12, "mtime_ns": 7, "nlink": 1}, "note": "a folder presents the entry of the first disk that holds one, its mode, owner, size and time"},
