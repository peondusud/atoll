    {"disks": [{"id": "t1", "position": 0, "state": "failed"}, {"id": "t2", "position": 1, "state": "online"}], "file": {"state": "ok", "size": 2, "mtime_ns": 5, "copies": [{"disk": "t1", "state": "ok", "first_seen_ns": 500, "size": 2, "mtime_ns": 5, "mode": 420, "uid": 1000, "gid": 100, "nlink": 1}]}, "node": {"kind": "file", "disk": "t1", "mode": 420, "uid": 1000, "gid": 100, "size": 2, "mtime_ns": 5, "nlink": 1}, "note": "a copy on a failed disk presents when no copy is eligible, as mergerfs reads that branch last"},
