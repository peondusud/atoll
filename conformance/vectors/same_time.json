    {"a": 1600000000123456789, "b": 1600000000123456700, "precision_ns": 0, "same": false, "note": "an unknown precision compares exactly"},
    {"a": 1600000000123456789, "b": 1600000000123456700, "precision_ns": 100, "same": true, "note": "what NTFS keeps of a time: its multiple of 100 ns below"},
    {"a": 1600000000123456700, "b": 1600000000123456799, "precision_ns": 100, "same": true, "note": "both ends of one tick of 100 ns"},
    {"a": 1600000000123456799, "b": 1600000000123456800, "precision_ns": 100, "same": false, "note": "1 ns apart, across a tick"},
    {"a": 1600000000999999999, "b": 1600000000000000000, "precision_ns": 1000000000, "same": true, "note": "ext4 with 128-byte inodes keeps the second"},
    {"a": 1600000000999999999, "b": 1600000001000000000, "precision_ns": 1000000000, "same": false, "note": "1 ns apart, across a second"},
