    {"ops": [{"kind": "create", "disk": "t2", "path": "D/f"}, {"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}], "path": "E/f", "source": {"kind": "disk", "disk": "t2"}, "note": "a file made below a folder of the catalog, then the folder renamed on every disk"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}, {"kind": "rename", "disk": "t2", "path": "E/x.mkv", "path2": "G/x.mkv"}], "path": "G/x.mkv", "source": {"kind": "disk", "disk": "t2"}, "note": "a file renamed out of a folder renamed"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}, {"kind": "rename", "disk": "t2", "path": "E/x.mkv", "path2": "G/x.mkv"}], "path": "E/x.mkv", "source": {"kind": "absent"}, "note": "and not left behind in it"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}, {"kind": "unlink", "disk": "t2", "path": "E/x.mkv"}], "path": "E/x.mkv", "source": {"kind": "absent"}, "note": "a file deleted below a folder renamed"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}, {"kind": "unlink", "disk": "t2", "path": "E/x.mkv"}], "path": "E/y.mkv", "source": {"kind": "catalog", "paths": ["D/y.mkv", "E/y.mkv"]}, "note": "its neighbour still presents"},
    {"ops": [{"kind": "rmdir", "disk": "t1", "path": "D", "folder": true}, {"kind": "mkdir", "disk": "t2", "path": "D"}], "path": "D", "source": {"kind": "disk", "disk": "t2"}, "note": "a folder made again after its removal"},
    {"ops": [{"kind": "rmdir", "disk": "t1", "path": "D", "folder": true}, {"kind": "mkdir", "disk": "t2", "path": "D"}], "path": "D/x.mkv", "source": {"kind": "absent"}, "note": "what was below the folder removed stays gone"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "F/a.mkv", "path2": "F/b.mkv"}, {"kind": "rename", "disk": "t1", "path": "F/b.mkv", "path2": "F/a.mkv"}], "path": "F/a.mkv", "source": {"kind": "disk", "disk": "t1"}, "note": "renamed back"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "F/a.mkv", "path2": "F/b.mkv"}, {"kind": "rename", "disk": "t1", "path": "F/b.mkv", "path2": "F/a.mkv"}], "path": "F/b.mkv", "source": {"kind": "absent"}, "note": "and nothing at the name it had for a moment"},
