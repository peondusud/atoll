    {"ops": [{"kind": "link", "disk": "t1", "path": "F/a.mkv", "path2": "G/b.mkv"}], "dir": "F", "catalog_dirs": ["F"], "names": [], "note": "the name a hard link was made from adds none to its folder's listing"}
