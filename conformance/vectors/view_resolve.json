    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}], "path": "D/x.mkv", "source": {"kind": "absent"}, "note": "nothing below its old name"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}], "path": "D", "source": {"kind": "absent"}, "note": "nor at it"},
