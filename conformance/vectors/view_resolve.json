    {"ops": [{"kind": "create", "disk": "t2", "path": "F/a.mkv"}, {"kind": "unlink", "disk": "t2", "path": "F/a.mkv"}], "path": "F/a.mkv", "source": {"kind": "absent"}, "note": "deleted after it was made"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "F/a.mkv", "path2": "F/b.mkv"}], "path": "F/b.mkv", "source": {"kind": "disk", "disk": "t1"}, "note": "a file renamed presents at its new name what its disk holds there"},
    {"ops": [{"kind": "rename", "disk": "t1", "path": "F/a.mkv", "path2": "F/b.mkv"}], "path": "F/a.mkv", "source": {"kind": "absent"}, "note": "and nothing at its old name"},
    {"ops": [{"kind": "write", "disk": "t1", "path": "F/a.mkv"}, {"kind": "rename", "disk": "t1", "path": "F/a.mkv", "path2": "F/b.mkv"}], "path": "F/b.mkv", "source": {"kind": "disk", "disk": "t1"}, "note": "written, then renamed"},
    {"ops": [{"kind": "replace", "disk": "t2", "path": "F/tmp", "path2": "F/a.nfo"}], "path": "F/a.nfo", "source": {"kind": "disk", "disk": "t2"}, "note": "a rename onto a name presents what replaced it"},
    {"ops": [{"kind": "replace", "disk": "t2", "path": "F/tmp", "path2": "F/a.nfo"}], "path": "F/tmp", "source": {"kind": "absent"}, "note": "and nothing at the name it left"},
    {"ops": [{"kind": "rmdir", "disk": "t1", "path": "Old", "folder": true}], "path": "Old", "source": {"kind": "absent"}, "note": "a folder removed"},
    {"ops": [{"kind": "rmdir", "disk": "t1", "path": "Old", "folder": true}], "path": "Old/x", "source": {"kind": "absent"}, "note": "nothing below a folder removed"},
    {"ops": [{"kind": "rmdir", "disk": "t1", "path": "Old", "folder": true}], "path": "Older", "source": {"kind": "catalog", "paths": ["Older"]}, "note": "a name that only starts like it is no part of it"},
