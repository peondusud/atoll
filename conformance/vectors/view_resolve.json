    {"ops": [{"kind": "mkdir", "disk": "t2", "path": "N"}, {"kind": "symlink", "disk": "t2", "path": "N/l"}, {"kind": "mkdir", "disk": "t2", "path": "N/S"}], "dir": "N", "catalog_dirs": ["N"], "names": ["S", "l"], "note": "a folder made, with what was made in it, in byte order"},
