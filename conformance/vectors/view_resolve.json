    {"ops": [{"kind": "rename", "disk": "t1", "path": "D", "path2": "E", "folder": true}, {"kind": "rename", "disk": "t1", "path": "E", "path2": "F2", "folder": true}], "dir": "F2", "catalog_dirs": ["D", "E", "F2"], "names": [], "note": "a folder renamed twice"},
