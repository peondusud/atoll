    {"ops": [{"kind": "link", "disk": "t1", "path": "F/a.mkv", "path2": "G/a.mkv"}, {"kind": "rename", "disk": "t1", "path": "G/a.mkv", "path2": "G/b.mkv"}], "path": "G/a.mkv", "source": {"kind": "absent"}, "note": "and nothing at the name it had for a moment"},
