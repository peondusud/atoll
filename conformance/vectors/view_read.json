  "description": "Which copy of a file Atoll's own view reads, best first: it opens the first it can, and keeps it until the file is closed. With read.policy = \"oldest\", the copy presented (the original) alone, and read.classes changes nothing. With \"prefer-spinning\", the copies that hold the file at its path, ok or surplus with no clock running and their file's rename followed, on a data disk online, standby, readonly or draining, and the copy presented in any case: first those on a disk that is not in standby, then by the first class of read.classes the disk carries (a disk that carries none after those that do), then the copy presented, then by position.",
  "cases": [
    {"note": "oldest: the copy presented alone", "disks": [{"id": "t1", "position": 0, "state": "online"}, {"id": "t2", "position": 1, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t2", "policy": "oldest", "classes": [], "read": ["t2"]},
    {"note": "oldest: classes change nothing", "disks": [{"id": "t1", "position": 0, "state": "online", "tags": ["sata"]}, {"id": "t2", "position": 1, "state": "online", "tags": ["usb"]}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t2", "policy": "oldest", "classes": ["sata", "usb"], "read": ["t2"]},
    {"note": "oldest: even when its disk sleeps", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "oldest", "classes": [], "read": ["t1"]},
    {"note": "a copy on a disk that spins before the one presented, asleep", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t2", "t1"]},
    {"note": "both spin: the copy presented first", "disks": [{"id": "t1", "position": 0, "state": "online"}, {"id": "t2", "position": 1, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t2", "policy": "prefer-spinning", "classes": [], "read": ["t2", "t1"]},
    {"note": "both spin: the first class of read.classes its disk carries before the copy presented", "disks": [{"id": "t1", "position": 0, "state": "online", "tags": ["usb"]}, {"id": "t2", "position": 1, "state": "online", "tags": ["sata"]}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": ["sata", "usb"], "read": ["t2", "t1"]},
    {"note": "spinning before the class: a USB disk that spins before a SATA one asleep", "disks": [{"id": "t1", "position": 0, "state": "standby", "tags": ["sata"]}, {"id": "t2", "position": 1, "state": "online", "tags": ["usb"]}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": ["sata", "usb"], "read": ["t2", "t1"]},
    {"note": "both asleep: the class decides", "disks": [{"id": "t1", "position": 0, "state": "standby", "tags": ["usb"]}, {"id": "t2", "position": 1, "state": "standby", "tags": ["sata"]}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": ["sata", "usb"], "read": ["t2", "t1"]},
    {"note": "a disk that carries no class comes after those that carry one", "disks": [{"id": "t1", "position": 0, "state": "online"}, {"id": "t2", "position": 1, "state": "online", "tags": ["sata"]}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": ["sata"], "read": ["t2", "t1"]},
    {"note": "the earliest class a disk carries is its own, whatever the order of its tags", "disks": [{"id": "t1", "position": 0, "state": "online", "tags": ["usb"]}, {"id": "t2", "position": 1, "state": "online", "tags": ["sata"]}, {"id": "t3", "position": 2, "state": "online", "tags": ["usb", "ssd"]}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}, {"disk": "t3", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": ["ssd", "sata", "usb"], "read": ["t3", "t2", "t1"]},
    {"note": "then the position, among copies not presented", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "online"}, {"id": "t3", "position": 2, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t3", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t2", "t3", "t1"]},
    {"note": "a stale copy is never read", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "stale"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t1"]},
    {"note": "a surplus copy is read as an ok one", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "surplus"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t2", "t1"]},
    {"note": "neither a copy whose clock runs nor one behind its file's rename holds the file at its path", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "online"}, {"id": "t3", "position": 2, "state": "online"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok", "gone_kind": "gone"}, {"disk": "t3", "state": "ok", "old_path": "old/a"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t1"]},
    {"note": "read-only and draining disks count as spinning: nothing records them asleep", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "readonly"}, {"id": "t3", "position": 2, "state": "draining"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t3", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t2", "t3", "t1"]},
    {"note": "no copy on a disk missing, failed or retired, nor on a cache disk", "disks": [{"id": "t1", "position": 0, "state": "standby"}, {"id": "t2", "position": 1, "state": "missing"}, {"id": "t3", "position": 2, "state": "failed"}, {"id": "t4", "position": 3, "state": "retired"}, {"id": "c1", "position": 4, "state": "online", "role": "cache"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}, {"disk": "t3", "state": "ok"}, {"disk": "t4", "state": "ok"}, {"disk": "c1", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t1"]},
    {"note": "the copy presented is read even on a failed disk, when no other may be", "disks": [{"id": "t1", "position": 0, "state": "failed"}, {"id": "t2", "position": 1, "state": "missing"}], "copies": [{"disk": "t1", "state": "ok"}, {"disk": "t2", "state": "ok"}], "presented": "t1", "policy": "prefer-spinning", "classes": [], "read": ["t1"]}
