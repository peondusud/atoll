                {"disk": "t1", "path": "Films/a.mkv", "kinds": ["deleted"], "origins": ["user"]},
                {"disk": "t1", "path": "Séries/X", "folder": true, "kinds": ["created"], "origins": ["user"]}],
     "disks": [{"disk": "t1", "names": [{"path": "Films/a.mkv", "deleted": true}, {"path": "Films/b.mkv"}, {"path": "Séries/X", "folder": true}]}]},
