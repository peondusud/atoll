{
  "format_version": 1,
  "spec": "specs.md §15.7",
  "description": "Whether a path collides with the names on an NTFS target: at some component, their prefixes up to that component have the same lpath_key and different bytes. Only the first component that collides is reported.",
  "cases": [
    { "existing": [], "path": "Films/a.mkv", "with": [], "note": "an empty target" },
    { "existing": ["Films/a.mkv"], "path": "Films/b.mkv", "with": [], "note": "same folder, another name" },
    { "existing": ["Films/a.mkv"], "path": "Films/a.mkv", "with": [], "note": "a path never collides with itself" },
    { "existing": ["Films/a.mkv"], "path": "Series/a.mkv", "with": [] },
    { "existing": ["a/Film.mkv"], "path": "b/film.mkv", "with": [], "note": "different folders: the case of the file name does not matter" },
    { "existing": ["Film.mkv"], "path": "Film.mkv.part", "with": [], "note": "a longer name" },
    { "existing": ["Films"], "path": "Films/a.mkv", "with": [], "note": "the same prefix, byte for byte: whether Films is a file is another check" },
    { "existing": ["Film.mkv"], "path": "film.mkv", "component": 0, "with": ["Film.mkv"] },
    { "existing": ["Films/Film.mkv"], "path": "Films/FILM.MKV", "component": 1, "with": ["Films/Film.mkv"] },
    { "existing": ["Films/a.mkv"], "path": "films/b.mkv", "component": 0, "with": ["Films"], "note": "the whole paths have different keys: only the folder collides" },
    { "existing": ["Series/Show/Season 01/a.mkv"], "path": "Series/Show/season 01/b.mkv", "component": 2, "with": ["Series/Show/Season 01"] },
    { "existing": ["Films/x/a.mkv"], "path": "Films/X", "component": 1, "with": ["Films/x"], "note": "a file against a folder" },
    { "existing": ["Films"], "path": "films/a.mkv", "component": 0, "with": ["Films"], "note": "a folder against a file" },
    { "existing": ["Films/A/a.mkv"], "path": "films/a/b.mkv", "component": 0, "with": ["Films"], "note": "only the first component that collides" },
    { "existing": ["Films/a/x", "Films/B/y"], "path": "Films/b/z", "component": 1, "with": ["Films/B"] },
    { "existing": ["films/a", "FILMS/b"], "path": "Films/c", "component": 0, "with": ["FILMS", "films"], "note": "every name at that component, in byte order" },
    { "existing": ["film.mkv", "Film.mkv"], "path": "FILM.MKV", "component": 0, "with": ["Film.mkv", "film.mkv"], "note": "two names already side by side" },
    { "existing": ["Film.mkv", "film.mkv"], "path": "Film.mkv", "component": 0, "with": ["film.mkv"], "note": "the path itself is not listed" },
    { "existing": ["caf\u00e9.mkv"], "path": "cafe\u0301.mkv", "component": 0, "with": ["caf\u00e9.mkv"], "note": "NFC against NFD: the key is wider than NTFS" },
    { "existing": ["\u00c9.mkv"], "path": "\u00e9.mkv", "component": 0, "with": ["\u00c9.mkv"], "note": "an accented letter" },
    { "existing": ["\u01f0.mkv"], "path": "J\u030c.mkv", "component": 0, "with": ["\u01f0.mkv"], "note": "a precomposed letter against its decomposed upper case" },
    { "existing": ["\u03c2.mkv"], "path": "\u03c3.mkv", "component": 0, "with": ["\u03c2.mkv"], "note": "final and medial sigma: the key is wider than NTFS" },
    { "existing": ["\u0416.mkv"], "path": "\u0436.mkv", "component": 0, "with": ["\u0416.mkv"], "note": "Cyrillic" },
    { "existing": ["\u00df.mkv"], "path": "\u1e9e.mkv", "with": [], "note": "sharp s and its capital have different keys" },
    { "existing": ["ss.mkv"], "path": "\u00df.mkv", "with": [], "note": "no full case folding" },
    { "existing": ["s.mkv"], "path": "\u017f.mkv", "with": [], "note": "long s has its own key" },
    { "existing": ["\ud801\udc00.mkv"], "path": "\ud801\udc28.mkv", "with": [], "note": "above U+FFFF, names are compared exactly" },
    { "existing": [], "existing_b64": ["RmlsbXP/"], "path_b64": "ZmlsbXP/", "with": [], "note": "not valid UTF-8: no key, so no collision" },
    { "existing": [], "existing_b64": ["RmlsbXMvYf8="], "path": "films/b.mkv", "component": 0, "with": ["Films"], "note": "the folder has a key, though the file below it has none" },
    { "existing": ["films/x"], "path_b64": "RmlsbXMvYf8=", "component": 0, "with": ["films"], "note": "the folder of the path has a key, though the path has none" },
    { "existing": [], "path": "", "error": true },
    { "existing": [], "path": "/a", "error": true },
    { "existing": [], "path": "a/", "error": true },
    { "existing": [], "path": "a//b", "error": true },
    { "existing": [], "path": "a/./b", "error": true },
    { "existing": [], "path": "a/../b", "error": true },
    { "existing": [], "path": "a\u0000b", "error": true },
    { "existing": ["a//b"], "path": "c", "error": true, "note": "a name on the target that is not well formed" },
    { "existing": [""], "path": "c", "error": true, "note": "a name on the target that is not well formed" }
  ]
}
