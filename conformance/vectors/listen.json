      "note": "three parts"
    },
    {
      "input": "127.0.0.256:80",
      "error": true,
      "note": "a part past 255"
    },
    {
      "input": "127.0.0.1.1:80",
      "error": true,
      "note": "five parts"
    },
    {
      "input": "::1:7341",
      "error": true,
      "note": "IPv6 without brackets"
    },
    {
      "input": "[::1]",
