{
  "format_version": 1,
  "spec": "specs.md §15.4",
  "description": "What a metadata-only change applies: the modification time of the last changed copy whose time moved, from, to each other copy that is not stale and holds another, through an operation where a pass can write to it, by making it stale otherwise.",
  "cases": [
    {"note": "no copy changed", "copies": [{"disk": "t1", "position": 0, "state": "ok", "row_mtime": 1}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1, "reachable": true}], "plan": {}},
    {"note": "a change with no time moved, as a chmod alone: nothing to apply", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 1, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1, "reachable": true}], "plan": {}},
    {"note": "a time moved: the other copy gets it", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1, "reachable": true}], "plan": {"mtime": 9, "from": "t1", "apply": ["t2"]}},
    {"note": "a copy whose row already says that time gets nothing", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 9, "reachable": true}], "plan": {"mtime": 9, "from": "t1"}},
    {"note": "a difference that was already there is not the change: the change is applied all the same", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 3, "reachable": true}], "plan": {"mtime": 9, "from": "t1", "apply": ["t2"]}},
    {"note": "a copy this pass cannot write to goes stale", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "unavailable", "row_mtime": 1}], "plan": {"mtime": 9, "from": "t1", "stale": ["t2"]}},
    {"note": "unless it holds that time already", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 9}], "plan": {"mtime": 9, "from": "t1"}},
    {"note": "a stale copy gets nothing: its refresh brings the time", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "stale", "row_mtime": 1, "reachable": true}, {"disk": "t3", "position": 2, "state": "stale", "row_mtime": 1}], "plan": {"mtime": 9, "from": "t1"}},
    {"note": "two copies changed to two times: the last change gives the time, by change time", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 60, "reachable": true}, {"disk": "t2", "position": 1, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 7, "ctime": 61, "reachable": true}], "plan": {"mtime": 7, "from": "t2", "apply": ["t1"]}},
    {"note": "on a tie of change times, the first by position", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 60, "reachable": true}, {"disk": "t2", "position": 1, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 7, "ctime": 60, "reachable": true}], "plan": {"mtime": 9, "from": "t1", "apply": ["t2"]}},
    {"note": "every copy changed to one time, as a touch through mergerfs: nothing to apply", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 60, "reachable": true}, {"disk": "t2", "position": 1, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 61, "reachable": true}], "plan": {"mtime": 9, "from": "t2"}},
    {"note": "a later change that moved no time does not give the time, and gets it, by what its look found", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 60, "reachable": true}, {"disk": "t2", "position": 1, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 1, "ctime": 70, "reachable": true}], "plan": {"mtime": 9, "from": "t1", "apply": ["t2"]}},
    {"note": "a changed copy that lost, on a disk this pass cannot write to, goes stale", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 60}, {"disk": "t2", "position": 1, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 7, "ctime": 61, "reachable": true}], "plan": {"mtime": 7, "from": "t2", "stale": ["t1"]}},
    {"note": "everything at once, given in any order, comes out by position", "copies": [{"disk": "e", "position": 4, "state": "surplus", "row_mtime": 9, "reachable": true}, {"disk": "c", "position": 2, "state": "unavailable", "row_mtime": 1}, {"disk": "a", "position": 0, "changed": true, "state": "ok", "row_mtime": 1, "mtime": 9, "ctime": 50, "reachable": true}, {"disk": "d", "position": 3, "state": "stale", "row_mtime": 1}, {"disk": "b", "position": 1, "state": "ok", "row_mtime": 1, "reachable": true}, {"disk": "f", "position": 5, "state": "corrupt", "row_mtime": 2, "reachable": true}], "plan": {"mtime": 9, "from": "a", "apply": ["b", "f"], "stale": ["c"]}},
    {"note": "NTFS holds the time already, as finely as it can: nothing to apply there", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1600000000000000000, "mtime": 1600000000000000150, "ctime": 50, "reachable": true, "precision_ns": 1}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1600000000000000100, "reachable": true, "precision_ns": 100}], "plan": {"mtime": 1600000000000000150, "from": "t1"}},
    {"note": "the next tick of NTFS is another time", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1600000000000000000, "mtime": 1600000000000000150, "ctime": 50, "reachable": true, "precision_ns": 1}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1600000000000000000, "reachable": true, "precision_ns": 100}], "plan": {"mtime": 1600000000000000150, "from": "t1", "apply": ["t2"]}},
    {"note": "the precision of the copy that gives the time counts too: a second from ext4 with 128-byte inodes", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1500000000000000000, "mtime": 1600000001000000000, "ctime": 50, "reachable": true, "precision_ns": 1000000000}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1600000001500000000, "reachable": true, "precision_ns": 1}], "plan": {"mtime": 1600000001000000000, "from": "t1"}},
    {"note": "an unknown precision compares exactly", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1600000000000000000, "mtime": 1600000000000000150, "ctime": 50, "reachable": true}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1600000000000000100, "reachable": true}], "plan": {"mtime": 1600000000000000150, "from": "t1", "apply": ["t2"]}},
    {"note": "a copy on a disk away that holds the time at its precision does not go stale", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1600000000000000000, "mtime": 1600000000000000150, "ctime": 50, "reachable": true, "precision_ns": 1}, {"disk": "t2", "position": 1, "state": "unavailable", "row_mtime": 1600000000000000100, "precision_ns": 100}], "plan": {"mtime": 1600000000000000150, "from": "t1"}},
    {"note": "a changed copy is compared exactly with its own row, which is what that disk held: one tick of NTFS moved it", "copies": [{"disk": "t1", "position": 0, "changed": true, "state": "ok", "row_mtime": 1600000000000000100, "mtime": 1600000000000000200, "ctime": 50, "reachable": true, "precision_ns": 100}, {"disk": "t2", "position": 1, "state": "ok", "row_mtime": 1600000000000000100, "reachable": true, "precision_ns": 1}], "plan": {"mtime": 1600000000000000200, "from": "t1", "apply": ["t2"]}},
    {"note": "a disk twice", "copies": [{"disk": "t1", "position": 0, "state": "ok", "row_mtime": 1}, {"disk": "t1", "position": 1, "state": "ok", "row_mtime": 1}], "error": true},
    {"note": "a position twice", "copies": [{"disk": "t1", "position": 0, "state": "ok", "row_mtime": 1}, {"disk": "t2", "position": 0, "state": "ok", "row_mtime": 1}], "error": true},
    {"note": "an unknown state", "copies": [{"disk": "t1", "position": 0, "state": "fine", "row_mtime": 1}], "error": true},
    {"note": "a pending copy holds nothing yet", "copies": [{"disk": "t1", "position": 0, "state": "pending", "row_mtime": 1}], "error": true}
  ]
}
