{
  "format_version": 1,
  "spec": "specs.md §29.5",
  "description": "The regex grammar: the common subset of Go regexp and Rust regex in which both engines give the same meaning. Each pattern is the text after re:, matched as a path condition without ignore_case; a rejected pattern is an error when the configuration loads.",
  "cases": [
    { "pattern": "^Films/", "path": "Films/a.mkv", "match": true, "note": "unanchored unless ^, $, \\A or \\z" },
    { "pattern": "Films", "path": "Archives/Films/a.mkv", "match": true },
    { "pattern": "a|b", "path": "b", "match": true },
    { "pattern": "^(a|b)c$", "path": "bc", "match": true },
    { "pattern": "^(?:ab)+$", "path": "abab", "match": true },
    { "pattern": "^(?i)abc$", "path": "ABC", "match": true },
    { "pattern": "^(?i:a)b$", "path": "Ab", "match": true },
    { "pattern": "^(?i:a)b$", "path": "AB", "match": false },
    { "pattern": "^(?i)a(?-i)b$", "path": "Ab", "match": true },
    { "pattern": "^(?i)a(?-i)b$", "path": "AB", "match": false },
    { "pattern": "^(?im-s:a)$", "path": "a", "match": true },
    { "pattern": "^a.b$", "path": "a\u000ab", "match": false, "note": ". does not match a newline without s" },
    { "pattern": "^(?s)a.b$", "path": "a\u000ab", "match": true },
    { "pattern": "^b", "path": "a\u000ab", "match": false, "note": "^ is the start of the text without m" },
    { "pattern": "(?m)^b", "path": "a\u000ab", "match": true },
    { "pattern": "^(?U)a+$", "path": "aaa", "match": true, "note": "U swaps greediness, which never changes whether a regex matches" },
    { "pattern": "^a{2}$", "path": "aa", "match": true },
    { "pattern": "^a{2}$", "path": "aaa", "match": false },
    { "pattern": "^a{2,}$", "path": "aaaa", "match": true },
    { "pattern": "^a{2,3}$", "path": "aaaa", "match": false },
    { "pattern": "^a{0,1000}$", "path": "aaa", "match": true },
    { "pattern": "^a+?$", "path": "aaa", "match": true, "note": "lazy repeat" },
    { "pattern": "^a{2,3}?$", "path": "aa", "match": true },
    { "pattern": "^(a{10}){100}$", "path": "", "match": true, "note": "nested counts multiply to exactly 1000" },
    { "pattern": "^(a{1000}){0}b$", "path": "b", "match": true, "note": "an upper bound of 0 ends the chain" },
    { "pattern": "^(a{2,}){500}$", "path": "", "match": true },
    { "pattern": "^(a{1000})*$", "path": "", "match": true, "note": "* does not count" },
    { "pattern": "\\.mkv$", "path": "a.mkv", "match": true },
    { "pattern": "\\.mkv$", "path": "amkv", "match": false },
    { "pattern": "^\\\\\\.\\+\\*\\?\\(\\)\\|\\[\\]\\{\\}\\^\\$\\-$", "path": "\\.+*?()|[]{}^$-", "match": true, "note": "every escapable character" },
    { "pattern": "^a\\tb$", "path": "a\u0009b", "match": true },
    { "pattern": "^\\x41$", "path": "A", "match": true },
    { "pattern": "^\\x{e9}$", "path": "é", "match": true },
    { "pattern": "^\\x{1F600}$", "path": "😀", "match": true },
    { "pattern": "^\\pL$", "path": "é", "match": true },
    { "pattern": "^\\p{Lu}$", "path": "a", "match": false },
    { "pattern": "^\\P{Lu}$", "path": "a", "match": true },
    { "pattern": "^\\p{Greek}$", "path": "α", "match": true },
    { "pattern": "^\\p{Old_Italic}$", "path": "𐌀", "match": true },
    { "pattern": "^\\p{Nd}+$", "path": "٣٤", "match": true },
    { "pattern": "\\A[a-z]+\\z", "path": "abc", "match": true },
    { "pattern": "^[a-z]$", "path": "m", "match": true },
    { "pattern": "^[^a-z]$", "path": "m", "match": false },
    { "pattern": "^[-a]$", "path": "-", "match": true, "note": "a - first is literal" },
    { "pattern": "^[a-]$", "path": "-", "match": true, "note": "a - last is literal" },
    { "pattern": "^[^-a]$", "path": "b", "match": true },
    { "pattern": "^[a-z-]$", "path": "-", "match": true },
    { "pattern": "^[\\]]$", "path": "]", "match": true },
    { "pattern": "^[\\[]$", "path": "[", "match": true },
    { "pattern": "^[\\\\]$", "path": "\\", "match": true },
    { "pattern": "^[\\-a]$", "path": "-", "match": true },
    { "pattern": "^[a^]$", "path": "^", "match": true, "note": "^ is literal unless first" },
    { "pattern": "^[\\p{Greek}a]$", "path": "α", "match": true },
    { "pattern": "^[\\x{41}-\\x{43}]$", "path": "B", "match": true },
    { "pattern": "^[a&b]$", "path": "&", "match": true, "note": "a single & or ~ is literal" },
    { "pattern": "^[a~b]$", "path": "~", "match": true },
    { "pattern": "^<a>$", "path": "<a>", "match": true, "note": "< and > are literal" },
    { "pattern": "^a&&b~~c$", "path": "a&&b~~c", "match": true, "note": "&& and ~~ are literal outside a class" },
    { "pattern": "^#a b$", "path": "#a b", "match": true, "note": "no x flag: # and spaces are literal" },
    { "pattern": "^a-b$", "path": "a-b", "match": true },
    { "pattern": "^\\{tmdb-[0-9]+\\}$", "path": "{tmdb-19995}", "match": true, "note": "braces are written \\{ and \\}" },
    { "pattern": "", "path": "", "match": true, "note": "1000 bytes: the longest regex" },
    { "pattern": "^[\\--a]$", "path": "0", "match": true, "note": "the first - is escaped: a range from - to a" },
    { "pattern": "^[a-z\u0301]$", "path": "\u00e9", "match": true, "note": "the grammar applies to the NFC form: z and U+0301 compose into \u017a, so the range ends at U+017A" },
    { "pattern": "^[!-\\-]$", "path": "-", "match": true, "note": "a range from ! to an escaped -" },
    { "pattern": "", "error": true, "note": "empty" },
    { "pattern": "a|", "error": true, "note": "empty alternative" },
    { "pattern": "|a", "error": true, "note": "empty alternative" },
    { "pattern": "a||b", "error": true, "note": "empty alternative" },
    { "pattern": "()", "error": true, "note": "empty group" },
    { "pattern": "(?:)", "error": true, "note": "empty group" },
    { "pattern": "", "error": true, "note": "longer than 1000 bytes" },
    { "pattern": "\\d", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\D", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\w", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\W", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\s", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\S", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\b", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\B", "error": true, "note": "ASCII-only in Go, Unicode in Rust" },
    { "pattern": "\\Qa\\E", "error": true, "note": "\\Q…\\E exists in Go only" },
    { "pattern": "\\E", "error": true },
    { "pattern": "\\<a", "error": true, "note": "a word boundary in Rust, a literal < in Go" },
    { "pattern": "a\\>", "error": true },
    { "pattern": "\\0", "error": true, "note": "octal escapes and back-references" },
    { "pattern": "\\1", "error": true },
    { "pattern": "\\101", "error": true, "note": "octal in Go, an error in Rust" },
    { "pattern": "\\C", "error": true },
    { "pattern": "\\Z", "error": true },
    { "pattern": "\\G", "error": true },
    { "pattern": "\\e", "error": true },
    { "pattern": "\\%", "error": true, "note": "only the listed characters can be escaped" },
    { "pattern": "a\\", "error": true, "note": "trailing backslash" },
    { "pattern": "\\n\u0301", "error": true, "note": "the grammar applies to the NFC form: n and U+0301 compose into \u0144, and \\\u0144 is not an escape; write \\n\\x{301}" },
    { "pattern": "[A-\u037e]", "error": true, "note": "the grammar applies to the NFC form: U+037E becomes ;, so the range is reversed" },
    { "pattern": "[a&&b]", "error": true, "note": "intersection in Rust, literal characters in Go" },
    { "pattern": "[a--b]", "error": true, "note": "difference in Rust" },
    { "pattern": "[a~~b]", "error": true, "note": "symmetric difference in Rust" },
    { "pattern": "[!-&&]", "error": true, "note": "two unescaped & in a row, even after a range end: write [!-&]" },
    { "pattern": "[a-~~]", "error": true, "note": "two unescaped ~ in a row, even after a range end: write [a-~]" },
    { "pattern": "[!---]", "error": true, "note": "two unescaped - in a row, even after a range end: write [!-\\-]" },
    { "pattern": "[--a]", "error": true },
    { "pattern": "[a[b]]", "error": true, "note": "a nested class in Rust" },
    { "pattern": "[[:alpha:]]", "error": true, "note": "POSIX classes are not supported" },
    { "pattern": "[[]", "error": true },
    { "pattern": "[]a]", "error": true, "note": "a ] is never a class character, even first, where both engines would read it as literal: write \\]" },
    { "pattern": "[]", "error": true },
    { "pattern": "[^]", "error": true },
    { "pattern": "[a", "error": true },
    { "pattern": "[z-a]", "error": true, "note": "reversed range" },
    { "pattern": "[a-\\pL]", "error": true, "note": "a range ends with a character" },
    { "pattern": "[a-b-c]", "error": true, "note": "a - after a range" },
    { "pattern": "[\\d]", "error": true },
    { "pattern": "[\\A]", "error": true },
    { "pattern": "a{", "error": true, "note": "a { must start a repeat" },
    { "pattern": "a{,3}", "error": true, "note": "Go reads it as literal text, Rust rejects it" },
    { "pattern": "a{1,2", "error": true, "note": "unterminated repeat" },
    { "pattern": "{tmdb-1}", "error": true, "note": "write \\{ and \\}" },
    { "pattern": "a}", "error": true, "note": "write \\}" },
    { "pattern": "]", "error": true, "note": "write \\]" },
    { "pattern": "a{01}", "error": true, "note": "no leading zero" },
    { "pattern": "a{3,2}", "error": true, "note": "n must not exceed m" },
    { "pattern": "a{1001}", "error": true, "note": "a count is at most 1000" },
    { "pattern": "(a{501}){2}", "error": true, "note": "nested counts multiply to 1002" },
    { "pattern": "(a{2,}){501}", "error": true },
    { "pattern": "((a{10}){10}){11}", "error": true },
    { "pattern": "a**", "error": true, "note": "a repeat applies to an atom" },
    { "pattern": "a*+", "error": true, "note": "possessive repeat in other engines" },
    { "pattern": "a++", "error": true },
    { "pattern": "a{2}{3}", "error": true },
    { "pattern": "a{2}*", "error": true },
    { "pattern": "a???", "error": true },
    { "pattern": "*a", "error": true, "note": "nothing to repeat" },
    { "pattern": "+", "error": true },
    { "pattern": "?", "error": true },
    { "pattern": "^*", "error": true },
    { "pattern": "$+", "error": true },
    { "pattern": "\\A?", "error": true },
    { "pattern": "(?i)*", "error": true },
    { "pattern": "(?x)a", "error": true, "note": "only the flags i, m, s and U" },
    { "pattern": "(?u)a", "error": true },
    { "pattern": "(?R)a", "error": true },
    { "pattern": "(?ii)a", "error": true, "note": "a flag twice" },
    { "pattern": "(?i-i)a", "error": true },
    { "pattern": "(?)a", "error": true },
    { "pattern": "(?-)a", "error": true },
    { "pattern": "(?i-)a", "error": true },
    { "pattern": "(?P<n>a)", "error": true, "note": "named groups are not supported" },
    { "pattern": "(?<n>a)", "error": true },
    { "pattern": "(?=a)", "error": true, "note": "no lookaround" },
    { "pattern": "(?!a)", "error": true },
    { "pattern": "(?<=a)b", "error": true },
    { "pattern": "(a", "error": true, "note": "( without )" },
    { "pattern": "a)", "error": true, "note": ") without (" },
    { "pattern": "\\p{^Lu}", "error": true, "note": "negation is written \\P" },
    { "pattern": "\\p{greek}", "error": true, "note": "names are spelled exactly" },
    { "pattern": "\\p{IsGreek}", "error": true },
    { "pattern": "\\p{sc=Greek}", "error": true },
    { "pattern": "\\p{Alphabetic}", "error": true, "note": "binary properties are not supported" },
    { "pattern": "\\p{Any}", "error": true },
    { "pattern": "\\p{Cn}", "error": true, "note": "Cn and Cs are left out" },
    { "pattern": "\\p{Cs}", "error": true },
    { "pattern": "\\p{LC}", "error": true },
    { "pattern": "\\p{Sidetic}", "error": true, "note": "a script added in Unicode 17.0" },
    { "pattern": "\\pX", "error": true },
    { "pattern": "\\p", "error": true },
    { "pattern": "\\p{L", "error": true },
    { "pattern": "\\x{D800}", "error": true, "note": "a surrogate is not a scalar value" },
    { "pattern": "\\x{110000}", "error": true },
    { "pattern": "\\x{}", "error": true },
    { "pattern": "\\x{1234567}", "error": true, "note": "1 to 6 hexadecimal digits" },
    { "pattern": "\\xZ1", "error": true },
    { "pattern": "\\x1", "error": true }
  ]
}
