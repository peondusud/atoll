  "spec": "specs.md §19",
  "description": "Which files on the SSD cache leave it now, and why; every other file on the cache is resident. A file is due once its residency is over (since_ns + min_age_ns at or before now_ns), when its policy says cache = false, or when the cache is not enabled; a due file leaves while replication.window is open. A file atoll replicate names leaves at once. Above max_fill of a cache disk's capacity, files on that disk leave at once, the oldest residency first, then by path, until what is left is at most max_fill, the files leaving already counted as gone; the disks by position. A file of mode manual waiting for atoll replicate never leaves but when that command names it.",
  "cases": [
    {"note": "nothing on the cache", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 1000}], "files": [], "leave": []},
    {"note": "residency not over: resident, window open or not", "now_ns": 100, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100}], "leave": []},
    {"note": "residency over, window open: it leaves", "now_ns": 200, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100}], "leave": [{"path": "x", "why": "due"}]},
    {"note": "residency over, window closed: resident until it opens", "now_ns": 200, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100}], "leave": []},
    {"note": "residency over at now exactly: due", "now_ns": 150, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100}], "leave": [{"path": "x", "why": "due"}]},
    {"note": "one nanosecond short: resident", "now_ns": 149, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100}], "leave": []},
    {"note": "cache_min_age 0s: due at once", "now_ns": 50, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 0}], "leave": [{"path": "x", "why": "due"}]},
    {"note": "a residency that began after now, as a clock set back: resident", "now_ns": 100, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 500, "min_age_ns": 0}], "leave": []},
    {"note": "cache = false: due at once, whatever its residency", "now_ns": 100, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 90, "min_age_ns": 1000, "cache": false}], "leave": [{"path": "x", "why": "due"}]},
    {"note": "cache = false, window closed: it waits for the window", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 90, "min_age_ns": 1000, "cache": false}], "leave": []},
    {"note": "cache.enabled false: every file is due, and the cache empties in the window", "now_ns": 100, "enabled": false, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 90, "min_age_ns": 1000}, {"path": "y", "size": 10, "disks": ["c"], "since_ns": 95, "min_age_ns": 1000}], "leave": [{"path": "x", "why": "due"}, {"path": "y", "why": "due"}]},
    {"note": "manual, waiting for atoll replicate: never due", "now_ns": 200, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100, "held": true}], "leave": []},
