    {"note": "a manual file atoll replicate names leaves too", "now_ns": 60, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100, "held": true, "released": true}], "leave": [{"path": "x", "why": "released"}]},
    {"note": "named and due in the window: released", "now_ns": 200, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": 100, "released": true}], "leave": [{"path": "x", "why": "released"}]},
    {"note": "above max_fill, window closed: the oldest leave at once until what is left is at most max_fill", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 100}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}, {"path": "b", "size": 60, "disks": ["c"], "since_ns": 5, "min_age_ns": 1000}, {"path": "c", "size": 100, "disks": ["c"], "since_ns": 20, "min_age_ns": 1000}], "leave": [{"path": "a", "why": "full"}, {"path": "b", "why": "full"}]},
    {"note": "at max_fill exactly: nothing leaves for room", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 200}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}], "leave": []},
    {"note": "one byte above: the oldest leaves", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 199}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}, {"path": "b", "size": 50, "disks": ["c"], "since_ns": 20, "min_age_ns": 1000}], "leave": [{"path": "a", "why": "full"}]},
    {"note": "what leaves in the window counts as gone first", "now_ns": 200, "window_open": true, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 100}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}, {"path": "b", "size": 150, "disks": ["c"], "since_ns": 50, "min_age_ns": 100}], "leave": [{"path": "b", "why": "due"}]},
    {"note": "a manual file waiting is never sent for room: the next oldest goes", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 150}], "files": [{"path": "a", "size": 500, "disks": ["c"], "since_ns": 1, "min_age_ns": 1000, "held": true}, {"path": "b", "size": 60, "disks": ["c"], "since_ns": 5, "min_age_ns": 1000}], "leave": [{"path": "b", "why": "full"}]},
    {"note": "one residency: by path", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 190}], "files": [{"path": "b", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}, {"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}], "leave": [{"path": "a", "why": "full"}]},
    {"note": "nothing left to send: what can go goes, and the disk stays above max_fill", "now_ns": 100, "max_fill": "50%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 100}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}], "leave": [{"path": "a", "why": "full"}]},
    {"note": "max_fill 100%: nothing leaves early", "now_ns": 100, "max_fill": "100%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 0}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}], "leave": []},
    {"note": "space not known: nothing leaves for room", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0}], "files": [{"path": "a", "size": 50, "disks": ["c"], "since_ns": 10, "min_age_ns": 1000}], "leave": []},
