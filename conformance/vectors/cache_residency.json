    {"note": "a negative min_age", "now_ns": 100, "max_fill": "80%", "disks": [{"id": "c", "position": 0, "capacity": 1000, "free": 900}], "files": [{"path": "x", "size": 10, "disks": ["c"], "since_ns": 50, "min_age_ns": -1}], "error": true},
