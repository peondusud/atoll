{
  "format_version": 1,
  "spec": "specs.md §15.4, §15.12, §17.2",
  "description": "A pass killed once it has recorded a modification: the next one finds the copy edited as its row now says, and runs the trash job and the copy that follows.",
  "clock": "2030-01-01T00:00:00Z",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x",
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x",
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n[modifies.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "write",
      "disk": "t1",
      "path": "media/a",
      "text": "y"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "crash_at": "modified",
      "exit": 137
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state, verified_ns IS NOT NULL FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok",
          1
        ],
        [
          "t2",
          "user",
          "stale",
          0
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT kind, src_disk, dst_disk, reason, state FROM jobs ORDER BY id",
      "rows": [
        [
          "trash",
          "t1",
          "t2",
          "overwritten",
          "queued"
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "overwritten",
            "outcome": "trashed"
          },
          {
            "disk": "t2",
            "kind": "replicate",
            "path": "a",
            "source": "t1",
            "outcome": "replicated"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "text": "y"
        },
        {
          "path": "Atoll/trash/2030-01-01/*/a",
          "text": "x"
        },
        {
          "path": "Atoll/tmp",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state, verified_ns IS NOT NULL FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok",
          1
        ],
        [
          "t2",
          "atoll",
          "ok",
          1
        ]
      ]
    }
  ]
}
