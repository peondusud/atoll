{
  "format_version": 1,
  "spec": "specs.md \u00a721.1, \u00a725",
  "description": "The data disks in configuration order, the cache disk left out, each branch with what min_free keeps free on its disk: 100 GiB on a 4 TiB disk, 5% of the two others. A size is written in the largest unit of 1024 that holds it exactly, otherwise in bytes. A minfreespace not larger than the largest file only warns: the command still exits with 0.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 20971520,
      "tree": [
        {
          "path": "media/a.mkv",
          "text": "x"
        }
      ]
    },
    {
      "id": "u1",
      "uuid": "01D9F3A2B4C5E6F7",
      "fs": "ntfs",
      "capacity": 4398046511104,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    },
    {
      "id": "x1",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "xfs",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/b.mkv",
          "size": 60000
        }
      ]
    },
    {
      "id": "c1",
      "uuid": "5f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[placement]\nmin_free = [\"5%\", \"100GiB\"]\n[[disk]]\nid = \"u1\"\nuuid = \"01D9F3A2B4C5E6F7\"\nmount = \"${SANDBOX}/disks/u1\"\nfs = \"ntfs\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"x1\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/x1\"\nfs = \"xfs\"\n[[disk]]\nid = \"c1\"\nuuid = \"5f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/c1\"\nfs = \"ext4\"\nrole = \"cache\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "mergerfs-config",
        "--json"
      ],
      "stdout_json": {
        "mount": "${SANDBOX}/pool",
        "branches": [
          {
            "disk": "u1",
            "path": "${SANDBOX}/disks/u1/media",
            "mode": "RW",
            "minfreespace_bytes": 107374182400
          },
          {
            "disk": "t1",
            "path": "${SANDBOX}/disks/t1/media",
            "mode": "RW",
            "minfreespace_bytes": 1048576
          },
          {
            "disk": "x1",
            "path": "${SANDBOX}/disks/x1/media",
            "mode": "RW",
            "minfreespace_bytes": 50000
          }
        ],
        "options": [
          "category.search=ff",
          "category.action=epall",
          "category.create=mfs",
          "moveonenospc=false",
          "rename-exdev=passthrough",
          "link-exdev=passthrough",
          "cache.attr=1",
          "cache.entry=1",
          "cache.negative_entry=0"
        ],
        "largest_file_bytes": 60000,
        "fstab": "${SANDBOX}/disks/u1/media=RW,100G:${SANDBOX}/disks/t1/media=RW,1M:${SANDBOX}/disks/x1/media=RW,50000 ${SANDBOX}/pool mergerfs category.search=ff,category.action=epall,category.create=mfs,moveonenospc=false,rename-exdev=passthrough,link-exdev=passthrough,cache.attr=1,cache.entry=1,cache.negative_entry=0 0 0"
      }
    },
    {
      "do": "atoll",
      "args": [
        "mergerfs-config"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/a.mkv",
          "text": "x"
        }
      ]
    }
  ]
}
