      "do": "expect_tree",
      "disk": "t3",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/trash",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, kind, state FROM ops ORDER BY id",
      "rows": [
        [
          1,
          "trash",
          "undone"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM trash",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1"
        ],
        [
          "t2"
        ],
        [
          "t3"
        ]
      ]
    },
    {
      "do": "atoll",
