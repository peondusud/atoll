    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "a",
        "--yes"
      ],
      "crash_at": "moved",
      "exit": 137
    },
    {
      "do": "expect_tree",
      "disk": "t3",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/trash/2026-01-01/1",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, kind, state FROM ops ORDER BY id",
      "rows": [
        [
          1,
          "trash",
          "done"
        ],
        [
          2,
          "restore",
          "planned"
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "a",
        "--yes",
        "--json"
