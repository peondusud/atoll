        "branches": [
          {
            "disk": "t2",
            "path": "${SANDBOX}/disks/t2/media",
            "mode": "NC",
            "minfreespace_bytes": 1048576
          },
          {
            "disk": "t3",
            "path": "${SANDBOX}/disks/t3/media",
            "mode": "RW",
            "minfreespace_bytes": 1048576
          },
          {
            "disk": "t1",
            "path": "${SANDBOX}/disks/t1/media",
            "mode": "RO",
            "minfreespace_bytes": 1048576
          }
        ],
        "options": [
          "category.search=ff",
          "category.action=epall",
          "category.create=mfs",
          "moveonenospc=false",
          "rename-exdev=passthrough",
          "link-exdev=passthrough",
          "cache.attr=1",
          "cache.entry=1",
          "cache.negative_entry=0"
        ],
        "largest_file_bytes": null,
        "fstab": "${SANDBOX}/disks/t2/media=NC,1M:${SANDBOX}/disks/t3/media=RW,1M:${SANDBOX}/disks/t1/media=RO,1M ${SANDBOX}/pool mergerfs category.search=ff,category.action=epall,category.create=mfs,moveonenospc=false,rename-exdev=passthrough,link-exdev=passthrough,cache.attr=1,cache.entry=1,cache.negative_entry=0 0 0"
