{
  "format_version": 1,
  "spec": "specs.md §10, §22",
  "description": "A pass writes nothing to an NTFS disk Windows left hibernated, whose top holds a hiberfil.sys of 10 bytes: the file it would copy there waits, degraded. Once hibernation is turned off in Windows, which removes hiberfil.sys, the next pass copies it.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "01D9F3A2B4C5E6F7",
      "fs": "ntfs",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        },
        {
          "path": "hiberfil.sys",
          "text": "0123456789"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"01D9F3A2B4C5E6F7\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ntfs\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "10m"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        },
        {
          "path": "hiberfil.sys",
          "text": "0123456789"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, state FROM disks ORDER BY id",
      "rows": [
        [
          "t1",
          "online"
        ],
        [
          "t2",
          "readonly"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), state FROM files",
      "rows": [
        [
          "a",
          "degraded"
        ]
      ]
    },
    {
      "do": "delete",
      "disk": "t2",
      "path": "hiberfil.sys"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle"
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, state FROM disks ORDER BY id",
      "rows": [
        [
          "t1",
          "online"
        ],
        [
          "t2",
          "online"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), state FROM files",
      "rows": [
        [
          "a",
          "ok"
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/tmp",
          "kind": "dir"
        }
      ]
    }
  ]
}
