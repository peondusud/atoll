{
  "format_version": 1,
  "spec": "specs.md §14.1, §14.3",
  "description": "Without --now, the copy is only queued: a job and its pending copy, nothing on the disk, and the file shows pending. Asked again, nothing new is queued, as the plan counts the pending copy. With --now, the queued job runs.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t2",
            "source": "t1",
            "size": 1024,
            "outcome": "queued"
          }
        ]
      }
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT kind, src_disk, dst_disk, state, attempts, (SELECT count(*) FROM job_chunks) FROM jobs",
      "rows": [
        [
          "replicate",
          "t1",
          "t2",
          "queued",
          0,
          0
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state, file_key IS NOT NULL FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok",
          1
        ],
        [
          "t2",
          "atoll",
          "pending",
          0
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), state FROM files",
      "rows": [
        [
          "a",
          "pending"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM ops",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 0,
        "copies": []
      }
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a",
        "--now",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t2",
            "source": "t1",
            "size": 1024,
            "outcome": "replicated"
          }
        ]
      }
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/tmp",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state, file_key IS NOT NULL FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok",
          1
        ],
        [
          "t2",
          "atoll",
          "ok",
          1
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), state FROM files",
      "rows": [
        [
          "a",
          "ok"
        ]
      ]
    }
  ]
}
