{
  "format_version": 1,
  "spec": "specs.md \u00a717.2",
  "description": "A folder's rename left planned, and a scan before the reprise: the scan's clocks say moved of what Atoll moved itself. The reprise carries those rows all the same, so no copy reads as a user's rename, and the user's name for the file wins.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/x",
          "text": "1"
        },
        {
          "path": "media/d/w",
          "text": "w"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/x",
          "text": "1"
        },
        {
          "path": "media/d/w",
          "text": "w"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "mkdir",
      "disk": "t1",
      "path": "media/z"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/d/x",
      "to": "media/z/y"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/d",
      "to": "media/e"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "crash_at": "moved",
      "exit": 137
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [
          {
            "disk": "t2",
            "kind": "rename",
            "path": "e/x",
            "to": "z/y",
            "outcome": "renamed"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, CAST(c.old_lpath AS TEXT) FROM copies c JOIN files f ON f.id = c.file_id ORDER BY f.lpath, c.disk_id",
      "rows": [
        [
          "e/w",
          "t1",
          null
        ],
        [
          "e/w",
          "t2",
          null
        ],
        [
          "z/y",
          "t1",
          null
        ],
        [
          "z/y",
          "t2",
          null
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/e/w",
          "text": "w"
        },
        {
          "path": "media/z/y",
          "text": "1"
        }
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/e/w",
          "text": "w"
        },
        {
          "path": "media/z/y",
          "text": "1"
        }
      ]
    },
    {
