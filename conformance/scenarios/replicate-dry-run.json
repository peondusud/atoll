{
  "format_version": 1,
  "spec": "specs.md §14.3, §25",
  "description": "With --dry-run, replicate lists what it would copy as to-replicate and writes nothing: no job, no pending copy, no operation, nothing on the disk.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a",
        "--now",
        "--dry-run",
        "--json"
      ],
      "stdout_json": {
        "applied": false,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t2",
            "source": "t1",
            "size": 1024,
            "outcome": "to-replicate"
          }
        ]
      }
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT (SELECT count(*) FROM jobs), (SELECT count(*) FROM ops), (SELECT count(*) FROM copies)",
      "rows": [
        [
          0,
          0,
          1
        ]
      ]
    }
  ]
}
