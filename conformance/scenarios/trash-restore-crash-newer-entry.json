{
  "format_version": 1,
  "spec": "specs.md \u00a717.2, \u00a717.4",
  "description": "A restore finished by a reprise leaves the older entries of its path alone, not one trashed since it was journaled, from another disk that went on working.",
  "disks": [
    {
      "id": "state",
      "uuid": "5f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": []
    },
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t3",
      "uuid": "4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "steps": [
    {
      "do": "write",
      "disk": "state",
      "path": "two.toml",
      "text": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\n"
    },
    {
      "do": "write",
      "disk": "state",
      "path": "one.toml",
      "text": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\n[[rule]]\nlabel = \"less\"\npath = \"**\"\nreplicas = 0\n"
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/two.toml",
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/two.toml",
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/two.toml",
        "prune",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t3",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/two.toml",
        "trash",
        "restore",
        "a",
        "--yes"
      ],
      "crash_at": "moved",
      "exit": 137
    },
    {
      "do": "unmount",
      "disk": "t3"
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/one.toml",
        "scan",
        "--full"
      ],
      "exit": 4
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/one.toml",
        "prune",
        "--yes",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t2",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "mount",
      "disk": "t3"
    },
    {
      "do": "atoll",
      "args": [
        "--config",
        "${SANDBOX}/disks/state/one.toml",
        "trash",
        "restore",
        "a",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "entries": [
          {
            "path": "a",
            "disk": "t2",
            "op": 3,
            "outcome": "restored"
          }
        ]
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, kind, state FROM ops ORDER BY id",
      "rows": [
        [
          1,
          "trash",
          "done"
        ],
        [
          2,
          "restore",
          "done"
        ],
        [
          3,
          "trash",
          "done"
        ],
        [
          4,
          "restore",
          "done"
        ]
      ]
    }
  ]
}
