  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\n[[rule]]\nlabel = \"more\"\npath = \"d\"\nreplicas = 2\n",
  "steps": [
    {
      "do": "link",
      "disk": "t3",
      "path": "media/c",
      "to": "media/d"
    },
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "prune",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "c",
            "disk": "t3",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "purge",
        "--older-than",
        "0s",
        "--yes"
      ],
      "crash_at": "moved",
      "exit": 137
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "purge",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 0,
        "entries": []
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, kind, state FROM ops ORDER BY id",
      "rows": [
        [
          1,
          "trash",
          "done"
        ],
        [
          2,
          "unlink",
          "done"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.nlink FROM copies c JOIN files f ON f.id = c.file_id WHERE c.disk_id = 't3' ORDER BY f.lpath",
      "rows": [
        [
          "d",
          1
        ]
      ]
    },
    {
