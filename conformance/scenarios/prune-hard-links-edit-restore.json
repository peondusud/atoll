    {
      "do": "link",
      "disk": "t3",
      "path": "media/c",
      "to": "media/d"
    },
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
