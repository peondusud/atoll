        "entries": [
          {
            "path": "c",
            "disk": "t3",
            "op": 1,
            "outcome": "restored"
          }
        ]
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.nlink FROM copies c JOIN files f ON f.id = c.file_id WHERE c.disk_id = 't3' ORDER BY f.lpath",
