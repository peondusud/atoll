    },
    {
      "do": "write",
      "disk": "t3",
      "path": "media/d",
      "size": 1024,
      "mtime_ns": 1600000000000000000
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "c",
        "--yes",
        "--json"
      ],
      "stdout_json": {
