{
  "format_version": 1,
  "spec": "specs.md \u00a715.10, \u00a715.12",
  "description": "An empty folder renamed, and a new file put in it: only a copy that moved with the folder says that it was renamed, so the other disk keeps its folder. What is new below the new name gets its row once the folder is decided.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/x",
          "text": "1"
        },
        {
          "path": "media/d/y",
          "text": "2"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n[replication]\nenabled = false\n",
  "steps": [
    {
      "do": "mkdir",
      "disk": "t1",
      "path": "media/d"
    },
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/d",
      "to": "media/e"
    },
    {
      "do": "write",
      "disk": "t1",
      "path": "media/e/new",
      "text": "n"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, CAST(c.old_lpath AS TEXT) FROM copies c JOIN files f ON f.id = c.file_id ORDER BY f.lpath, c.disk_id",
      "rows": [
        [
          "d/x",
          "t2",
          null
        ],
        [
          "d/y",
          "t2",
          null
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), disk_id FROM entries ORDER BY lpath, disk_id",
      "rows": [
        [
          "d",
          "t2"
        ],
        [
          "e",
          "t1"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM jobs",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, CAST(c.old_lpath AS TEXT) FROM copies c JOIN files f ON f.id = c.file_id ORDER BY f.lpath, c.disk_id",
      "rows": [
        [
          "d/x",
          "t2",
          null
        ],
        [
          "d/y",
          "t2",
          null
        ],
        [
          "e/new",
          "t1",
          null
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/e/new",
          "text": "n"
        }
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
