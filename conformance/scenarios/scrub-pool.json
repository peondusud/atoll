            "scrubbed": true,
            "copies_read": 2,
            "bytes_read": 8,
            "corrupt": [],
            "quarantined": [],
            "kept": [],
            "changed": [],
            "left": false
          }
        ]
      }
    },
    {
      "do": "atoll",
      "args": [
        "scrub",
        "--json",
        "--disk",
        "t2",
        "--path",
        "Films"
      ],
      "stdout_json": {
        "applied": true,
        "disks": [
          {
            "id": "t2",
            "scrubbed": true,
            "copies_read": 1,
            "bytes_read": 2,
            "corrupt": [],
            "quarantined": [],
            "kept": [],
            "changed": [],
            "left": false
          }
        ]
      }
