        "disks": [
          {
            "id": "t1",
            "scrubbed": true,
            "copies_read": 1,
            "bytes_read": 2,
            "corrupt": [],
            "quarantined": [],
            "kept": [],
            "changed": [
              {
                "path": "a.mkv"
              }
            ],
            "left": false
          },
          {
