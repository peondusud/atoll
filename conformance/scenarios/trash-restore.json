            "path": "a",
            "disk": "t3",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "advance",
      "by": "10m"
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "a",
        "--dry-run",
        "--json"
      ],
      "stdout_json": {
        "applied": false,
        "entries": [
          {
            "path": "a",
            "disk": "t3",
            "op": 1,
            "outcome": "to-restore"
          }
        ]
      }
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "a",
        "--json"
      ],
      "exit": 3,
      "stdout_json": {
        "applied": false,
        "entries": [
          {
            "path": "a",
            "disk": "t3",
            "op": 1,
            "outcome": "to-restore"
