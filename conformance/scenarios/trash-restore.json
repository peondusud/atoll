      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "prune",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
