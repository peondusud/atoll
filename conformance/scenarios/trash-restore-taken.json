{
  "format_version": 1,
  "spec": "specs.md \u00a717.4",
  "description": "A path already taken leaves the entry in the trash, and is seen before anything is journaled. So is a parent of it that is not a folder.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
