{
  "format_version": 1,
  "spec": "specs.md \u00a717.4",
  "description": "A file at that place that is not the one trashed stays, with its entry. A dry run does not look at it, so it does not know.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t3",
      "uuid": "4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "prune",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t3",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "write",
      "disk": "t3",
      "path": "Atoll/trash/2026-01-01/1/b",
      "text": "other"
    },
    {
      "do": "rename",
      "disk": "t3",
      "path": "Atoll/trash/2026-01-01/1/b",
      "to": "Atoll/trash/2026-01-01/1/a"
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "purge",
        "--older-than",
        "0s",
        "--dry-run",
        "--json"
      ],
      "stdout_json": {
        "applied": false,
        "bytes": 1024,
        "entries": [
          {
            "path": "a",
            "disk": "t3",
            "op": 1,
            "size": 1024,
            "why": "older-than",
            "outcome": "to-purge"
          }
        ],
        "full": []
      }
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "purge",
        "--older-than",
        "0s",
        "--yes",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "applied": true,
        "bytes": 0,
        "entries": [
          {
            "path": "a",
            "disk": "t3",
            "op": 1,
            "size": 1024,
            "why": "older-than",
            "outcome": "changed"
          }
        ],
        "full": []
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT id, kind, state FROM ops ORDER BY id",
      "rows": [
        [
          1,
          "trash",
          "done"
        ],
        [
          2,
          "unlink",
          "undone"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM trash",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT kind FROM events WHERE kind = 'op-undone'",
      "rows": [
        [
          "op-undone"
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t3",
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        },
        {
          "path": "Atoll/trash/2026-01-01/1/a",
          "text": "other"
        }
      ]
    }
  ]
}
