{
  "format_version": 1,
  "spec": "specs.md \u00a76.1, \u00a717.4",
  "description": "A folder made for a restore leaves the time of the folder it lands in as it was.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/sub/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/sub/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t3",
      "uuid": "4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/sub/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "touch",
      "disk": "t3",
      "path": "media/d",
      "mtime_ns": 1600000000000000000
    },
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "prune",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "d/sub/a",
            "disk": "t3",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "delete",
      "disk": "t3",
      "path": "media/d/sub"
    },
    {
      "do": "touch",
      "disk": "t3",
      "path": "media/d",
      "mtime_ns": 1600000000000000000
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "d/sub/a",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "entries": [
          {
            "path": "d/sub/a",
            "disk": "t3",
            "op": 1,
            "outcome": "restored"
          }
        ]
      }
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT mtime_ns FROM entries WHERE disk_id = 't3' AND lpath = CAST('d' AS BLOB)",
      "rows": [
        [
          1600000000000000000
        ]
      ]
    }
  ]
}
