{
  "format_version": 1,
  "spec": "specs.md \u00a715.7, \u00a717.4",
  "description": "Refused for the path, then for a folder on the way, and nothing is written or journaled. A disk that is away is unavailable before any of that.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/Film",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "media/Dir/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "u1",
      "uuid": "01D9F3A2B4C5E6F7",
      "fs": "ntfs",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/Film",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "media/Dir/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"u1\"\nuuid = \"01D9F3A2B4C5E6F7\"\nmount = \"${SANDBOX}/disks/u1\"\nfs = \"ntfs\"\n[[rule]]\nlabel = \"single\"\npath = \"**\"\nreplicas = 0\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "prune",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 2048,
        "copies": [
          {
            "path": "Dir/a",
            "disk": "u1",
            "size": 1024,
            "outcome": "trashed"
          },
          {
            "path": "Film",
            "disk": "u1",
            "size": 1024,
            "outcome": "trashed"
          }
        ]
      }
    },
    {
      "do": "write",
      "disk": "u1",
      "path": "media/film",
      "text": "x"
    },
    {
      "do": "delete",
      "disk": "u1",
      "path": "media/Dir"
    },
    {
      "do": "write",
      "disk": "u1",
      "path": "media/dir/b",
      "text": "y"
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "Film",
        "--dry-run",
        "--json"
      ],
      "stdout_json": {
        "applied": false,
        "entries": [
          {
            "path": "Film",
            "disk": "u1",
            "op": 2,
            "outcome": "name-collision"
          }
        ]
      }
    },
    {
      "do": "unmount",
      "disk": "u1"
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "Film",
        "--dry-run",
        "--json"
      ],
      "stdout_json": {
        "applied": false,
        "entries": [
          {
            "path": "Film",
            "disk": "u1",
            "op": 2,
            "outcome": "disk-unavailable"
          }
        ]
      }
    },
    {
      "do": "mount",
      "disk": "u1"
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "Film",
        "--yes",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "applied": true,
        "entries": [
          {
            "path": "Film",
            "disk": "u1",
            "op": 2,
            "outcome": "name-collision"
          }
        ]
      }
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "restore",
        "Dir/a",
        "--yes",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "applied": true,
        "entries": [
          {
            "path": "Dir/a",
            "disk": "u1",
            "op": 1,
            "outcome": "name-collision"
          }
        ]
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM ops WHERE kind <> 'trash'",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "u1",
      "tree": [
        {
          "path": "media/film",
          "text": "x"
        },
        {
          "path": "media/dir/b",
          "text": "y"
        },
        {
          "path": "Atoll/trash/2026-01-01/1/Dir/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/trash/2026-01-01/2/Film",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ]
}
