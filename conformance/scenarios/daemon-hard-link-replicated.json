{
  "format_version": 1,
  "spec": "specs.md \u00a714, \u00a715.1, \u00a721.2",
  "description": "A hard link made on one disk, as Atoll's own view makes one: the new name is a file of its own, and its replica on the other disk is an independent full copy, never a link, while both names stay one file on the disk they were linked on.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[defaults]\nsettle = \"0s\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "link",
      "disk": "t1",
      "path": "media/a",
      "to": "media/b"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        },
        {
          "path": "media/b",
          "text": "x"
        },
        {
          "path": "Atoll",
          "kind": "dir"
        },
        {
          "path": "Atoll/tmp",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, c.nlink, c.created_by, c.state FROM copies c JOIN files f ON f.id = c.file_id WHERE f.lpath = CAST('b' AS BLOB) ORDER BY c.disk_id",
      "rows": [
        [
          "b",
          "t1",
          2,
          "user",
          "ok"
        ],
        [
          "b",
          "t2",
          1,
          "atoll",
          "ok"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, count(DISTINCT file_key) FROM copies GROUP BY disk_id ORDER BY disk_id",
      "rows": [
        [
          "t1",
          1
        ],
        [
          "t2",
          2
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM jobs",
      "rows": [
        [
          0
        ]
      ]
    }
  ]
}
