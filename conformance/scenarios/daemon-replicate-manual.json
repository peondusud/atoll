{
  "format_version": 1,
  "spec": "specs.md §12.2, §14.1, §15.12",
  "description": "A file in manual mode is never queued by a pass, however long it has been there, and counts for nothing in waiting: atoll replicate releases it and copies it.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[defaults]\nmode = \"manual\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "advance",
      "by": "1h"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT (SELECT count(*) FROM jobs), (SELECT count(*) FROM copies WHERE state = 'pending')",
      "rows": [
        [
          0,
          0
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a",
        "--now",
        "--json"
      ],
      "stdout_json": {
        "applied": true,
        "bytes": 1024,
        "copies": [
          {
            "path": "a",
            "disk": "t2",
            "source": "t1",
            "size": 1024,
            "outcome": "replicated"
          }
        ]
      }
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/tmp",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
