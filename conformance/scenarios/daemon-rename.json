    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/a",
      "to": "media/b"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
