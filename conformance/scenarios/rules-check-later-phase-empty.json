{
  "format_version": 1,
  "spec": "specs.md \u00a724.4",
  "description": "A setting the table lists under any gets its warning for an empty list too, as the file wrote it.",
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[read]\nclasses = []\n[health]\nevacuate_on = []\n[[rule]]\nlabel = \"r\"\ntags = []\ndomains = []\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "rules",
        "check",
        "--json"
      ],
      "stdout_json": {
        "valid": true,
        "problems": [],
        "warnings": [
          {
            "key": "health.evacuate_on",
            "later_phase": true,
            "message": "${ANY}"
          },
          {
            "key": "read.classes",
            "later_phase": true,
            "message": "${ANY}"
          },
          {
            "key": "rule[0].domains",
            "later_phase": true,
            "message": "${ANY}"
          },
          {
            "key": "rule[0].tags",
            "later_phase": true,
            "message": "${ANY}"
          }
        ]
      }
    }
  ]
}
