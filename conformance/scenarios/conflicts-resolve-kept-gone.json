{
 "format_version": 1,
 "spec": "specs.md \u00a715.7",
 "description": "A copy to keep that is no longer on its disk moves nothing, and the file stays in conflict.",
 "disks": [
  {
   "id": "t1",
   "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
   "fs": "ext4",
   "capacity": 1000000,
   "tree": [
    {
     "path": "media/a",
     "size": 1024,
     "mtime_ns": 1600000000000000000
    }
   ]
  },
  {
   "id": "t2",
   "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
   "fs": "ext4",
   "capacity": 1000000,
   "tree": [
    {
     "path": "media/a",
     "text": "xx",
     "mtime_ns": 1700000000000000000
    }
   ]
  }
 ],
 "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n",
 "steps": [
  {
   "do": "atoll",
   "args": [
    "init"
   ]
  },
  {
   "do": "atoll",
   "args": [
    "scan",
    "--full"
   ]
  },
  {
   "do": "delete",
   "disk": "t1",
   "path": "media/a"
  },
  {
   "do": "atoll",
   "args": [
    "conflicts",
    "resolve",
    "a",
    "--keep",
    "t1",
    "--yes",
    "--json"
   ],
   "exit": 4,
   "stdout_json": {
    "path": "a",
    "keep": "t1",
    "applied": true,
    "resolved": false,
    "bytes": 0,
    "copies": [
     {
      "disk": "t1",
      "size": 1024,
      "mtime_ns": 1600000000000000000,
      "outcome": "gone"
     },
     {
      "disk": "t2",
      "size": 2,
      "mtime_ns": 1700000000000000000,
      "outcome": "not-moved"
     }
    ]
   }
  },
  {
   "do": "expect_tree",
   "disk": "t2",
   "tree": [
    {
     "path": "media/a",
     "text": "xx",
     "mtime_ns": 1700000000000000000
    }
   ]
  },
  {
   "do": "expect_catalog",
   "query": "SELECT state FROM files",
   "rows": [
    [
     "conflict"
    ]
   ]
  },
  {
   "do": "expect_catalog",
   "query": "SELECT count(*) FROM events WHERE kind = 'conflict-resolve'",
   "rows": [
    [
     0
    ]
   ]
  }
 ]
}
