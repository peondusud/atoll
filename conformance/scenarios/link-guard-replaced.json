          "done"
        ]
      ]
    },
    {
      "do": "advance",
      "by": "10m"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "expect_catalog",
