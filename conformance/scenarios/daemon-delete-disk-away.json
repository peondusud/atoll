      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "unmount",
      "disk": "t2"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/a"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 4
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}",
            "walked": false
          }
        ],
        "decisions": [
          {
            "path": "a",
            "decision": "deleted"
          }
        ],
        "operations": [
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "deleted",
            "outcome": "disk-unavailable"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT kind, src_disk, dst_disk, state, reason FROM jobs",
      "rows": [
        [
          "trash",
          "t1",
          "t2",
          "queued",
          "deleted"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), state FROM files ORDER BY lpath",
      "rows": [
        [
          "a",
          "unavailable"
        ]
      ]
    },
    {
      "do": "mount",
      "disk": "t2"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "deleted",
            "outcome": "trashed"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media",
