{
  "format_version": 1,
  "spec": "specs.md \u00a714",
  "description": "A replica takes the extended attributes of the user. namespace its source holds, as part of restoring its metadata, before it is synced and read back: Samba's DOS attributes and what macOS writes through Samba, an empty value included.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x",
          "xattrs": [
            {
              "name": "user.DOSATTRIB",
              "text": "0x20"
            },
            {
              "name": "user.org.netatalk.Metadata",
              "text": ""
            }
          ]
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a",
        "--now"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "text": "x",
          "xattrs": [
            {
              "name": "user.DOSATTRIB",
              "text": "0x20"
            },
            {
              "name": "user.org.netatalk.Metadata",
              "text": ""
            }
          ]
        },
        {
          "path": "Atoll/tmp",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/a",
          "text": "x",
          "xattrs": [
            {
              "name": "user.DOSATTRIB",
              "text": "0x20"
            },
            {
              "name": "user.org.netatalk.Metadata",
              "text": ""
            }
          ]
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT c.disk_id, c.created_by, c.state FROM copies c ORDER BY c.disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok"
        ],
        [
          "t2",
          "atoll",
          "ok"
        ]
      ]
    }
  ]
