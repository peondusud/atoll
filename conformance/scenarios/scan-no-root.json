{
  "format_version": 1,
  "spec": "specs.md \u00a710, \u00a715.10",
  "description": "A disk that lost media/ is missing, and is never read as empty: every copy stays. Atoll does not create the folder.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/a"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media"
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "disks": [
          {
            "id": "t1",
            "state": "missing",
            "reason": "no-root",
            "message": "${ANY}",
            "walked": false,
            "files": 0,
            "bytes": 0,
            "folders": 0,
            "symlinks": 0,
            "ignored": 0,
            "new": 0,
            "known": 0,
            "hashed": 0,
            "changed": [],
            "absent": [],
            "moved": [],
            "path_taken": [],
            "unreadable": [],
            "other_mounts": []
          }
        ],
        "conflicts": []
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM copies",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": []
    }
  ]
}
