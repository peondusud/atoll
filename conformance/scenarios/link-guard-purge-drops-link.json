{
  "format_version": 1,
  "spec": "specs.md \u00a717, \u00a717.3, \u00a717.4",
  "description": "A copy Atoll sends to the trash keeps its link until the next pass; a purge before it removes the link first, as kind = unlink, so that the purged data does not stay behind it.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n[modifies.mass_guard]\npercent = \"100%\"\n[trash]\nlink_guard = true\n[defaults]\nreplicas = 0\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "prune",
        "--yes"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "trash",
        "purge",
        "--older-than",
        "0s",
        "--yes"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        },
        {
          "path": "Atoll/links",
          "kind": "dir"
        },
        {
          "path": "Atoll/trash",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, kind, link, state FROM ops WHERE id > 2 ORDER BY id",
      "rows": [
        [
          "t2",
          "trash",
          null,
          "done"
        ],
        [
          "t2",
          "unlink",
          1,
          "done"
        ],
        [
          "t2",
          "unlink",
          null,
          "done"
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        },
        {
          "path": "Atoll/links",
          "kind": "dir"
        },
        {
          "path": "Atoll/trash",
          "kind": "dir"
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM trash",
      "rows": [
        [
          0
        ]
      ]
    }
  ]
}
