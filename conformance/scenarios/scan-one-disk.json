{
  "format_version": 1,
  "spec": "specs.md \u00a713.4",
  "description": "With nowhere to place a replica, a file that wants one is degraded.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--json"
      ],
      "stdout_json": {
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true,
            "files": 1,
            "bytes": 1,
            "folders": 0,
            "symlinks": 0,
            "ignored": 0,
            "new": 1,
            "known": 0,
            "hashed": 0,
            "changed": [],
            "absent": [],
            "unreadable": [],
            "other_mounts": []
          }
        ],
        "conflicts": []
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(lpath AS TEXT), state FROM files ORDER BY lpath",
      "rows": [
        [
          "a",
          "degraded"
        ]
      ]
    }
  ]
}
