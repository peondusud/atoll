{
  "format_version": 1,
  "spec": "specs.md \u00a715.11",
  "description": "Status writes nothing to a disk, and changes nothing in the catalog, not even a time.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "1h"
    },
    {
      "do": "atoll",
      "args": [
        "status"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "status",
        "--json"
      ],
      "stdout_json": {
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "mount": "${SANDBOX}/disks/t1",
            "fs": "ext4",
            "role": "data",
            "capacity_bytes": 1000000,
            "free_bytes": 999999,
            "last_seen": "2026-01-01T00:00:00.000000000Z",
            "copies": 1,
            "bytes": 1
          }
        ],
        "files_total": 1,
        "files_at_level": 0,
        "bytes_total": 1,
        "bytes_at_level": 0,
        "by_state": {
          "ok": 0,
          "pending": 0,
          "degraded": 1,
          "unprotected": 0,
          "unavailable": 0,
          "corrupt": 0,
          "conflict": 0,
          "name-incompatible": 0,
          "name-collision": 0
        },
        "files": []
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM files WHERE updated_ns = 1767225600000000000",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM disks WHERE last_seen_ns = 1767225600000000000",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM events",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    }
  ]
}
