            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}",
            "walked": false
          }
        ],
        "decisions": [
          {
            "path": "d/g",
            "decision": "deleted"
          }
        ],
        "operations": [
          {
            "disk": "t2",
            "kind": "trash",
            "path": "d/g",
            "reason": "deleted",
            "outcome": "disk-unavailable"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
