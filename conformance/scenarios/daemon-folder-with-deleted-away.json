    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "unmount",
      "disk": "t2"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/d/g"
    },
    {
      "do": "atoll",
