            "to": "old"
          }
        ],
        "operations": [],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), f.blake3 IS NULL, c.verified_ns IS NULL FROM copies c JOIN files f ON f.id = c.file_id WHERE c.disk_id = 't2'",
      "rows": [
        [
          "a",
          1,
          1
        ]
      ]
    }
