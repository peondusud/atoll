            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [],
        "guards": [],
        "waiting": 1,
        "next_due": "${ANY}"
      }
    },
    {
      "do": "expect_tree",
      "disk": "c",
      "tree": [
        {
          "path": "media/show/e1.mkv",
          "text": "episode"
        }
