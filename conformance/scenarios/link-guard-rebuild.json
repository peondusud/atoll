{
  "format_version": 1,
  "spec": "specs.md \u00a79, \u00a717",
  "description": "A rebuilt catalog starts its files past the highest id the links folders name, so that an old link never names a new file: the next pass finds the old link leading to a copy, removes it, and gives the copy its new one.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n[modifies.mass_guard]\npercent = \"100%\"\n[trash]\nlink_guard = true\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "write",
      "disk": "t1",
      "path": "media/b",
      "size": 512,
      "mtime_ns": 1600000000000000000
    },
    {
      "do": "write",
      "disk": "t2",
      "path": "media/b",
      "size": 512,
      "mtime_ns": 1600000000000000000
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "media/b",
          "size": 512,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/links/1",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/links/2",
          "size": 512,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "do": "atoll",
      "args": [
        "catalog",
        "rebuild",
        "--yes"
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT seq >= 2 FROM sqlite_sequence WHERE name = 'files'",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM files WHERE id <= 2",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "media/b",
          "size": 512,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/links/3",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/links/4",
          "size": 512,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/a",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "media/b",
          "size": 512,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/links/3",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        },
        {
          "path": "Atoll/links/4",
          "size": 512,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM trash",
      "rows": [
        [
          0
        ]
      ]
    }
  ]
}
