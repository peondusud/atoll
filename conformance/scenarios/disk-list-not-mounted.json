{
  "format_version": 1,
  "spec": "specs.md \u00a710",
  "description": "A path that does not exist, a folder inside a disk and a symlink to one are no mount points, and nothing is written to any of them.",
  "disks": [
    {
      "id": "t0",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a.mkv",
          "text": "x"
        },
        {
          "path": "link",
          "kind": "symlink",
          "target": "media"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"a\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/nowhere\"\nfs = \"ext4\"\n[[disk]]\nid = \"b\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t0/media\"\nfs = \"ext4\"\n[[disk]]\nid = \"c\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t0/link\"\nfs = \"ext4\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "disk",
        "list",
        "--json"
      ],
      "stdout_json": {
        "disks": [
          {
            "id": "a",
            "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
            "fs": "ext4",
            "mount": "${SANDBOX}/nowhere",
            "role": "data",
            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}"
          },
          {
            "id": "b",
            "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
            "fs": "ext4",
            "mount": "${SANDBOX}/disks/t0/media",
            "role": "data",
            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}"
          },
          {
            "id": "c",
            "uuid": "4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
            "fs": "ext4",
            "mount": "${SANDBOX}/disks/t0/link",
            "role": "data",
            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}"
          }
        ]
      }
    },
    {
      "do": "expect_tree",
      "disk": "t0",
      "tree": [
        {
          "path": "media/a.mkv",
          "text": "x"
        },
        {
          "path": "link",
          "kind": "symlink",
          "target": "media"
        }
      ]
    }
  ]
}
