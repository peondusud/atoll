{
  "format_version": 1,
  "spec": "specs.md \u00a715.3, \u00a715.12",
  "description": "The trash job of a refused rename, confirmed while its disk is away, then the file deleted: that job is not one for the deletion, so the deletion queues its own beside it, and a dry run lists both, as the real pass does. Back, the first is canceled and the copy goes once.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        },
        {
          "path": "media/c",
          "text": "c"
        },
        {
          "path": "media/d",
          "text": "d"
        },
        {
          "path": "media/e",
          "text": "e"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "01D9F3A2B4C5E6F7",
      "fs": "ntfs",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "x"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"01D9F3A2B4C5E6F7\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ntfs\"\n[deletes.mass_guard]\nfiles = 100\npercent = \"50%\"\n[replication]\nenabled = false\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/a",
      "to": "media/a:b"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 3
    },
    {
      "do": "atoll",
      "args": [
        "guard",
        "confirm",
        "--disk",
        "t2"
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT kind, reason, state FROM jobs",
      "rows": [
        [
          "trash",
          "renamed",
          "queued"
        ]
      ]
    },
    {
      "do": "unmount",
      "disk": "t2"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/a:b"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 4
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--dry-run",
        "--json"
      ],
      "stdout_json": {
        "dry_run": true,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}",
            "walked": false
          }
        ],
        "decisions": [
          {
            "path": "a:b",
            "decision": "deleted"
          }
        ],
        "operations": [
          {
            "disk": "t2",
            "kind": "rename",
            "path": "a",
            "to": "a:b",
            "outcome": "disk-unavailable"
          },
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "renamed",
            "outcome": "disk-unavailable"
          },
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "deleted",
            "outcome": "disk-unavailable"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 4,
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "missing",
            "reason": "not-mounted",
            "message": "${ANY}",
            "walked": false
          }
        ],
        "decisions": [
          {
            "path": "a:b",
            "decision": "deleted"
          }
        ],
        "operations": [
          {
            "disk": "t2",
            "kind": "rename",
            "path": "a",
            "to": "a:b",
            "outcome": "disk-unavailable"
          },
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "renamed",
            "outcome": "disk-unavailable"
          },
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "deleted",
            "outcome": "disk-unavailable"
          }
        ],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT reason, src_disk, dst_disk FROM jobs WHERE kind = 'trash' AND state = 'queued' ORDER BY id",
      "rows": [
        [
          "renamed",
          "t2",
          "t2"
        ],
        [
          "deleted",
          "t1",
          "t2"
        ]
      ]
    },
    {
      "do": "mount",
      "disk": "t2"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [],
        "operations": [
          {
            "disk": "t2",
            "kind": "rename",
            "path": "a",
            "to": "a:b",
            "outcome": "name-refused"
          },
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "renamed",
            "outcome": "canceled"
          },
          {
            "disk": "t2",
            "kind": "trash",
            "path": "a",
            "reason": "deleted",
            "outcome": "trashed"
          }
        ],
        "guards": [],
