{
  "format_version": 1,
  "spec": "specs.md \u00a715.12, \u00a717.2",
  "description": "A folder rename stopped at journaled on the other disk, where a program then renames the folder away and makes a new one at its name, as a tool that rotates a folder does: the next pass takes the job to carry only the folder its entry records, by inode, so the new folder stays at its name (flaw 14 of conformance/models/README.md, the maintainer's remedy).",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/x",
          "text": "1"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/d/x",
          "text": "1"
        },
        {
          "path": "media/d/y",
          "text": "2"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/d",
      "to": "media/e"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "crash_at": "journaled",
      "exit": 137
    },
    {
      "do": "rename",
      "disk": "t2",
      "path": "media/d",
      "to": "media/f"
    },
    {
      "do": "mkdir",
      "disk": "t2",
      "path": "media/d"
    },
    {
      "do": "write",
      "disk": "t2",
      "path": "media/d/new",
      "text": "3"
    },
    {
      "do": "tick"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t2",
      "tree": [
        {
          "path": "media/d/new",
          "text": "3"
        },
        {
          "path": "media/f/x",
          "text": "1"
        },
        {
          "path": "media/f/y",
          "text": "2"
        }
      ]
    }
  ]
}
