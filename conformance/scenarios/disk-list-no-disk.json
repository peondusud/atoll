  "steps": [
    {
      "do": "atoll",
      "args": [
        "disk",
        "list",
        "--json"
      ],
      "stdout_json": {
        "disks": []
      }
    },
    {
      "do": "atoll",
      "args": [
        "disk",
        "list"
      ]
    }
  ]
}
