{
  "format_version": 1,
  "spec": "specs.md \u00a715.10, \u00a715.12",
  "description": "The same, with no copy of the file that takes the name on that disk: its row goes all the same, and a walk then adds it with the checks of a copy not yet in the catalog, so another size is a conflict.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/e1",
          "text": "1"
        },
        {
          "path": "media/e2",
          "text": "2"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/e1",
      "to": "media/e0"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/e2",
      "to": "media/e1"
    },
    {
      "do": "write",
      "disk": "t2",
      "path": "media/e1",
      "text": "new"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
            "id": "t1",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          },
          {
            "id": "t2",
            "state": "online",
            "reason": null,
            "message": null,
            "walked": true
          }
        ],
        "decisions": [
          {
            "path": "e1",
            "decision": "renamed",
            "to": "e0"
          },
          {
            "path": "e2",
            "decision": "renamed",
            "to": "e1"
          }
        ],
        "operations": [],
        "guards": [],
        "waiting": 0,
        "next_due": null
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, CAST(c.old_lpath AS TEXT) FROM copies c JOIN files f ON f.id = c.file_id ORDER BY f.lpath, c.disk_id",
      "rows": [
        [
          "e0",
          "t1",
          null
        ],
        [
          "e1",
          "t1",
          null
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, CAST(c.old_lpath AS TEXT) FROM copies c JOIN files f ON f.id = c.file_id ORDER BY f.lpath, c.disk_id",
      "rows": [
        [
          "e0",
          "t1",
          null
        ],
        [
          "e1",
          "t1",
          null
        ],
        [
          "e1",
          "t2",
          null
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT state FROM files WHERE CAST(lpath AS TEXT) = 'e1'",
      "rows": [
        [
          "conflict"
        ]
      ]
    }
  ]
}
