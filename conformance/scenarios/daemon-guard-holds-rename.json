{
  "format_version": 1,
  "spec": "specs.md \u00a715.6, \u00a715.12",
  "description": "A rename goes on under a guard. A gone copy of a renamed file, under that guard, keeps its row, with where it was: should it come back, the rename reaches it.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "1"
        },
        {
          "path": "media/b",
          "text": "2"
        },
        {
          "path": "media/c",
          "text": "3"
        },
        {
          "path": "media/d",
          "text": "4"
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/a",
          "text": "1"
        },
        {
          "path": "media/b",
          "text": "2"
        },
        {
          "path": "media/c",
          "text": "3"
        },
        {
          "path": "media/d",
          "text": "4"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\nfiles = 1\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan",
        "--full"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/a"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/b"
    },
    {
      "do": "delete",
      "disk": "t1",
      "path": "media/c"
    },
    {
      "do": "delete",
      "disk": "t2",
      "path": "media/d"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/d",
      "to": "media/e"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 3
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 3
    },
    {
      "do": "expect_catalog",
      "query": "SELECT CAST(f.lpath AS TEXT), c.disk_id, CAST(c.old_lpath AS TEXT) FROM copies c JOIN files f ON f.id = c.file_id ORDER BY f.lpath, c.disk_id",
      "rows": [
        [
          "a",
          "t1",
          null
        ],
        [
          "a",
          "t2",
          null
        ],
        [
          "b",
          "t1",
          null
        ],
        [
          "b",
          "t2",
          null
        ],
        [
          "c",
          "t1",
          null
        ],
        [
          "c",
          "t2",
          null
        ],
        [
          "e",
          "t1",
          null
        ]
      ]
    },
    {
      "do": "expect_tree",
      "disk": "t1",
      "tree": [
        {
          "path": "media/e",
          "text": "4"
        }
      ]
    }
  ]
}
