      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media/D/sub/c",
          "text": "c"
        },
        {
          "path": "media/D/a",
          "text": "a"
        },
        {
          "path": "media/D/sub/w",
          "text": "w"
        },
        {
          "path": "media/D/z",
          "text": "z"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\n[deletes.mass_guard]\npercent = \"100%\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "advance",
      "by": "1m"
    },
    {
      "do": "tick"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/D/sub",
      "to": "media/F"
    },
    {
      "do": "rename",
      "disk": "t1",
      "path": "media/D",
      "to": "media/E"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ]
    },
    {
      "do": "advance",
      "by": "30s"
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "stdout_json": {
        "dry_run": false,
        "disks": [
          {
