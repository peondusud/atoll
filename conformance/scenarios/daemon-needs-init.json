{
  "format_version": 1,
  "spec": "specs.md \u00a725, \u00a715.13",
  "description": "With no catalog there is nothing to read, and none is created: a daemon that would run for good exits with 1 at once.",
  "disks": [
    {
      "id": "state",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": []
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/disks/state/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--until-idle",
        "--json"
      ],
      "exit": 1
    },
    {
      "do": "atoll",
      "args": [
        "guard",
        "list",
        "--json"
      ],
      "exit": 1
    },
    {
      "do": "atoll",
      "args": [
        "guard",
        "confirm",
        "--disk",
        "state"
      ],
      "exit": 1
    },
    {
      "do": "atoll",
      "args": [
        "daemon"
      ],
      "exit": 1
    },
    {
      "do": "atoll",
      "args": [
        "daemon",
        "--dry-run"
      ],
      "exit": 1
    },
    {
      "do": "expect_tree",
      "disk": "state",
      "tree": []
    }
  ]
}
