{
  "format_version": 1,
  "spec": "specs.md \u00a713.3, \u00a76.1",
  "description": "A rule that now keeps a file's copies on usb disks leaves both its copies on sata disks: atoll balance moves only the copy Atoll made, and with --move-originals the user's copy too, first. The copy made in its place becomes the user copy as it is recorded, and the old one an Atoll copy, which goes to the trash as rebalance.",
  "disks": [
    {
      "id": "t1",
      "uuid": "3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 9000000,
      "tree": [
        {
          "path": "media/a.mkv",
          "size": 1024,
          "mtime_ns": 1600000000000000000
        }
      ]
    },
    {
      "id": "t2",
      "uuid": "7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d",
      "fs": "ext4",
      "capacity": 9000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    },
    {
      "id": "t3",
      "uuid": "4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    },
    {
      "id": "t4",
      "uuid": "5f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b",
      "fs": "ext4",
      "capacity": 1000000,
      "tree": [
        {
          "path": "media",
          "kind": "dir"
        }
      ]
    }
  ],
  "config": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\ntags = [\"sata\"]\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\ntags = [\"sata\"]\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\ntags = [\"usb\"]\n[[disk]]\nid = \"t4\"\nuuid = \"5f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t4\"\nfs = \"ext4\"\ntags = [\"usb\"]\n",
  "steps": [
    {
      "do": "atoll",
      "args": [
        "init"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "scan"
      ]
    },
    {
      "do": "atoll",
      "args": [
        "replicate",
        "a.mkv",
        "--now"
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok"
        ],
        [
          "t2",
          "atoll",
          "ok"
        ]
      ]
    },
    {
      "do": "config",
      "text": "pool_id = \"p\"\ncatalog = \"${SANDBOX}/catalog.db\"\n[view]\nmount = \"${SANDBOX}/pool\"\n[[disk]]\nid = \"t1\"\nuuid = \"3f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t1\"\nfs = \"ext4\"\ntags = [\"sata\"]\n[[disk]]\nid = \"t2\"\nuuid = \"7a2b4c6d-8e0f-4a1b-9c2d-3e4f5a6b7c8d\"\nmount = \"${SANDBOX}/disks/t2\"\nfs = \"ext4\"\ntags = [\"sata\"]\n[[disk]]\nid = \"t3\"\nuuid = \"4f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t3\"\nfs = \"ext4\"\ntags = [\"usb\"]\n[[disk]]\nid = \"t4\"\nuuid = \"5f1c9a2e-5b7d-4c1e-9a0b-2d4f6e8a1c3b\"\nmount = \"${SANDBOX}/disks/t4\"\nfs = \"ext4\"\ntags = [\"usb\"]\n[[rule]]\nlabel = \"usb\"\npath = \"**\"\ntags = [\"usb\"]\ntags_mode = \"strict\"\n"
    },
    {
      "do": "atoll",
      "args": [
        "balance",
        "--json"
      ],
      "exit": 3,
      "stdout_json": {
        "moves": [
          {
            "path": "a.mkv",
            "from": "t2",
            "to": "t3",
            "size": 1024,
            "outcome": "to-move"
          }
        ],
        "applied": false,
        "bytes": 1024,
        "originals": 1
      }
    },
    {
      "do": "atoll",
      "args": [
        "balance",
        "--move-originals",
        "--json"
      ],
      "exit": 3,
      "stdout_json": {
        "moves": [
          {
            "path": "a.mkv",
            "from": "t1",
            "to": "t3",
            "size": 1024,
            "outcome": "to-move"
          },
          {
            "path": "a.mkv",
            "from": "t2",
            "to": "t4",
            "size": 1024,
            "outcome": "to-move"
          }
        ],
        "applied": false,
        "bytes": 2048,
        "originals": 0
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "user",
          "ok"
        ],
        [
          "t2",
          "atoll",
          "ok"
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "balance",
        "--move-originals",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "moves": [
          {
            "path": "a.mkv",
            "from": "t1",
            "to": "t3",
            "size": 1024,
            "outcome": "moved"
          },
          {
            "path": "a.mkv",
            "from": "t2",
            "to": "t4",
            "size": 1024,
            "outcome": "moved"
          }
        ],
        "applied": true,
        "bytes": 2048,
        "originals": 0
      }
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, created_by, state FROM copies ORDER BY disk_id",
      "rows": [
        [
          "t3",
          "user",
          "ok"
        ],
        [
          "t4",
          "atoll",
          "ok"
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT disk_id, reason, size FROM trash ORDER BY disk_id",
      "rows": [
        [
          "t1",
          "rebalance",
          1024
        ],
        [
          "t2",
          "rebalance",
          1024
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT count(*) FROM jobs",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "do": "expect_catalog",
      "query": "SELECT state, original_disk FROM files",
      "rows": [
        [
          "ok",
          "t3"
        ]
      ]
    },
    {
      "do": "atoll",
      "args": [
        "balance",
        "--move-originals",
        "--yes",
        "--json"
      ],
      "stdout_json": {
        "moves": [],
        "applied": true,
        "bytes": 0,
        "originals": 0
      }
    }
  ]
}
