{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peondusud/atoll/schema/config.schema.json",
  "title": "Atoll configuration",
  "description": "The tree a TOML 1.1 parser gives for atoll.toml (specs.md §24). Atoll checks it against this schema with keys compared byte for byte, then applies each default. A format starting with atoll- is a grammar of specs.md §29.5, which a third-party validator ignores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pool_id", "view"],
  "properties": {
    "pool_id": { "$ref": "#/$defs/identifier" },
    "strategy": {
      "description": "A preset of other keys (specs.md §12.2). Left out: no preset.",
      "enum": ["safety", "energy", "capacity"]
    },
    "catalog": {
      "description": "On Windows, the default is %ProgramData%\\Atoll\\catalog.db.",
      "$ref": "#/$defs/absolute_path",
      "default": "/var/lib/atoll/catalog.db"
    },
    "timezone": {
      "description": "Time zone of every time window: local, or an IANA name, looked up on the machine.",
      "type": "string",
      "pattern": "^(local|[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*)$",
      "default": "local"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "$ref": "#/$defs/folder_name", "default": "media" },
        "workdir": { "$ref": "#/$defs/folder_name", "default": "Atoll" },
        "marker": {
          "description": "Write Atoll/disk.toml on each disk.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "disk": {
      "type": "array",
      "items": { "$ref": "#/$defs/disk" },
      "default": []
    },
    "defaults": {
      "description": "Pool-wide values of rule properties, and the alert on manual mode.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "$ref": "#/$defs/replicas", "default": 1 },
        "mode": { "$ref": "#/$defs/mode", "default": "deferred" },
        "settle": { "$ref": "#/$defs/duration", "default": "10m" },
        "priority": { "$ref": "#/$defs/priority", "default": 0 },
        "manual_alert_after": { "$ref": "#/$defs/duration", "default": "7d" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "new_files": {
          "enum": ["most-free", "ordered", "percent"],
          "default": "most-free"
        },
        "fill_to": {
          "description": "Of each disk's capacity, for ordered.",
          "$ref": "#/$defs/positive_percent",
          "default": "90%"
        },
        "min_free": {
          "description": "The smallest of these applies to each disk (specs.md §13.1).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?(%|B|KB|MB|GB|TB|KiB|MiB|GiB|TiB)$"
          },
          "format": "atoll-min-free",
          "default": ["5%", "100GiB"]
        },
        "spread": { "$ref": "#/$defs/spread", "default": "domain" },
        "spread_mode": { "$ref": "#/$defs/prefer_or_strict", "default": "prefer" },
        "tags_mode": { "$ref": "#/$defs/prefer_or_strict", "default": "prefer" },
        "colocate": { "$ref": "#/$defs/colocate", "default": "none" },
        "overflow": { "$ref": "#/$defs/overflow", "default": "allow" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount"],
      "properties": {
        "engine": { "enum": ["mergerfs", "atoll"], "default": "mergerfs" },
        "mount": { "$ref": "#/$defs/absolute_path" }
      }
    },
    "read": {
      "description": "Atoll's own view (phase 2a).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["oldest", "prefer-spinning"], "default": "oldest" },
        "classes": { "$ref": "#/$defs/identifiers", "default": [] }
      }
    },
    "maintenance": {
      "description": "Background work that wakes disks, and the default of the other windows.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": { "$ref": "#/$defs/window", "default": "02:00-06:00" },
        "rescan_every": { "$ref": "#/$defs/positive_duration", "default": "7d" },
        "catalog_on_disks": {
          "description": "Also back the catalog up to each disk's Atoll/catalog/.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "replication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "window": {
          "description": "Left out: maintenance.window.",
          "$ref": "#/$defs/window"
        },
        "max_parallel_per_disk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        }
      }
    },
    "deletes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct": { "enum": ["propagate", "restore"], "default": "propagate" },
        "debounce": { "$ref": "#/$defs/positive_duration", "default": "30s" },
        "mass_guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": { "type": "integer", "minimum": 0, "default": 100 },
            "percent": {
              "description": "Of a disk's copies.",
              "$ref": "#/$defs/percent",
              "default": "5%"
            },
            "window": { "$ref": "#/$defs/positive_duration", "default": "10m" }
          }
        }
      }
    },
    "modifies": {
      "description": "What stops a modification in mass (specs.md §15.6).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mass_guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": { "description": "Files modified from a copy on a disk.", "type": "integer", "minimum": 0, "default": 100 },
            "percent": {
              "description": "Of a disk's copies.",
              "$ref": "#/$defs/percent",
              "default": "5%"
            },
            "window": { "$ref": "#/$defs/positive_duration", "default": "10m" }
          }
        }
      }
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "description": "never, immediate or a time window. Left out: maintenance.window.",
          "type": "string",
          "pattern": "^(never|immediate|[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2})$",
          "format": "atoll-schedule"
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ratio_below": {
              "description": "Of the bytes correctly placed.",
              "$ref": "#/$defs/percent",
              "default": "90%"
            },
            "or_more_than": { "$ref": "#/$defs/size", "default": "200GiB" }
          }
        },
        "budget": { "$ref": "#/$defs/positive_duration", "default": "3h" },
        "equalize": { "enum": ["off", "percent"], "default": "off" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrub_every": { "$ref": "#/$defs/positive_duration", "default": "30d" },
        "window": {
          "description": "Left out: maintenance.window.",
          "$ref": "#/$defs/window"
        },
        "scrub_budget": { "$ref": "#/$defs/positive_duration", "default": "4h" },
        "auto_repair": { "type": "boolean", "default": true },
        "repair_mode": { "enum": ["chunk", "file"], "default": "chunk" },
        "manifest": {
          "description": "Write Atoll/manifest.b3sum on each disk.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "trash": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention": { "$ref": "#/$defs/positive_duration", "default": "30d" },
        "max_size": {
          "description": "Of each disk's capacity.",
          "$ref": "#/$defs/positive_percent",
          "default": "5%"
        },
        "link_guard": { "type": "boolean", "default": false }
      }
    },
    "cache": {
      "description": "SSD cache (phase 2b).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "min_age": { "$ref": "#/$defs/duration", "default": "7d" },
        "max_fill": {
          "description": "Of the cache's capacity.",
          "$ref": "#/$defs/positive_percent",
          "default": "80%"
        },
        "mirror": { "type": "boolean", "default": false },
        "replicate_early": { "type": "boolean", "default": false }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_grace": { "$ref": "#/$defs/duration", "default": "24h" },
        "remount_after_reset": { "type": "boolean", "default": true },
        "evacuate_on": {
          "description": "Phase 4.",
          "type": "array",
          "items": { "enum": ["smart_failing", "pending_sectors"] },
          "default": []
        },
        "avoid_hotter_than": {
          "description": "Phase 4. Left out: no limit.",
          "type": "string",
          "pattern": "^[0-9]{1,3}C$"
        }
      }
    },
    "ups": {
      "description": "Through NUT (phase 2b).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "nut": {
          "type": "string",
          "pattern": "^([^ \\t\\r\\n@]+@[^ \\t\\r\\n@]+)?$",
          "default": ""
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "$ref": "#/$defs/http_url", "default": "" },
            "token_file": { "$ref": "#/$defs/optional_path", "default": "" },
            "path_map": { "$ref": "#/$defs/path_map", "default": {} }
          }
        },
        "jellyfin": { "$ref": "#/$defs/media_server" },
        "emby": { "$ref": "#/$defs/media_server" }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ntfy": { "$ref": "#/$defs/http_url", "default": "" },
        "ntfy_token_file": {
          "description": "A file that holds the Bearer token of a ntfy server that asks one (specs.md §23).",
          "$ref": "#/$defs/optional_path",
          "default": ""
        },
        "gotify": { "$ref": "#/$defs/http_url", "default": "" },
        "smtp": {
          "type": "string",
          "pattern": "^(smtps?://[^ \\t\\r\\n]+)?$",
          "default": ""
        }
      }
    },
    "rule": {
      "description": "Ordered: the first matching rule wins (specs.md §11.3).",
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "default": []
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "identifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+[smhdw]$",
      "format": "atoll-duration"
    },
    "positive_duration": {
      "description": "A duration of 0 would remove a protection or stop a task without saying so.",
      "type": "string",
      "pattern": "^0*[1-9][0-9]*[smhdw]$",
      "format": "atoll-duration"
    },
    "size": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(B|KB|MB|GB|TB|KiB|MiB|GiB|TiB)$",
      "format": "atoll-size"
    },
    "percent": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?%$",
      "format": "atoll-percent"
    },
    "positive_percent": {
      "type": "string",
      "pattern": "^([0-9]*[1-9][0-9]*(\\.[0-9]+)?|[0-9]+\\.[0-9]*[1-9][0-9]*)%$",
      "format": "atoll-percent"
    },
    "window": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$",
      "format": "atoll-window"
    },
    "absolute_path": {
      "type": "string",
      "format": "atoll-absolute-path"
    },
    "optional_path": {
      "description": "An absolute path, or an empty string for not set.",
      "type": "string",
      "format": "atoll-optional-path"
    },
    "path_map": {
      "description": "Host path to the path the media server sees.",
      "type": "object",
      "propertyNames": { "format": "atoll-absolute-path" },
      "additionalProperties": { "$ref": "#/$defs/absolute_path" }
    },
    "http_url": {
      "description": "An http or https URL, or an empty string for not set.",
      "type": "string",
      "pattern": "^(https?://[^ \\t\\r\\n]+)?$"
    },
    "folder_name": {
      "description": "One path component with no leading dot: no hidden folders on a disk.",
      "type": "string",
      "pattern": "^[^./\\x00][^/\\x00]*$"
    },
    "media_server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/http_url", "default": "" },
        "api_key_file": { "$ref": "#/$defs/optional_path", "default": "" },
        "path_map": { "$ref": "#/$defs/path_map", "default": {} }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uuid", "mount", "fs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "uuid": {
          "description": "FS UUID, or 64-bit NTFS serial. Which one depends on fs (specs.md §24.3).",
          "type": "string",
          "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9A-F]{16})$"
        },
        "mount": { "$ref": "#/$defs/absolute_path" },
        "fs": { "enum": ["ext4", "ntfs", "xfs", "btrfs"] },
        "role": { "enum": ["data", "cache"], "default": "data" },
        "domain": {
          "description": "Failure domain. Left out: the disk forms its own.",
          "$ref": "#/$defs/identifier"
        },
        "tags": { "$ref": "#/$defs/identifiers", "default": [] },
        "root": {
          "description": "Left out: layout.root.",
          "$ref": "#/$defs/folder_name"
        },
        "workdir": {
          "description": "Left out: layout.workdir.",
          "$ref": "#/$defs/folder_name"
        }
      }
    },
    "replicas": { "type": "integer", "minimum": 0, "maximum": 2 },
    "mode": { "enum": ["immediate", "deferred", "scheduled", "manual"] },
    "priority": {
      "description": "The highest first.",
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "spread": { "enum": ["domain", "none"] },
    "prefer_or_strict": { "enum": ["prefer", "strict"] },
    "colocate": { "enum": ["none", "folder", "season", "show"] },
    "overflow": { "enum": ["allow", "deny"] },
    "rule": {
      "description": "Holds what the file sets, plus action and ignore_case. What the rule leaves out comes from specs.md §24.2 when it gives a file its policy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "filename": { "type": "string" },
        "ext": { "type": "array", "items": { "type": "string" } },
        "size_min": { "$ref": "#/$defs/size" },
        "size_max": { "$ref": "#/$defs/size" },
        "ignore_case": { "type": "boolean", "default": true },
        "action": { "enum": ["manage", "ignore"], "default": "manage" },
        "replicas": { "$ref": "#/$defs/replicas" },
        "mode": { "$ref": "#/$defs/mode" },
        "settle": { "$ref": "#/$defs/duration" },
        "priority": { "$ref": "#/$defs/priority" },
        "tags": { "$ref": "#/$defs/identifiers" },
        "tags_mode": { "$ref": "#/$defs/prefer_or_strict" },
        "domains": { "$ref": "#/$defs/identifiers" },
        "spread": { "$ref": "#/$defs/spread" },
        "spread_mode": { "$ref": "#/$defs/prefer_or_strict" },
        "colocate": { "$ref": "#/$defs/colocate" },
        "overflow": { "$ref": "#/$defs/overflow" },
        "cache": { "type": "boolean" },
        "cache_min_age": { "$ref": "#/$defs/duration" }
      }
    }
  }
}
